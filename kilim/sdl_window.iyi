# SDL window and event loop. Translates SDL events into kilim events and
# hands them to Ui; if Ui drew, presents to the screen.

module kilim/sdl_window

import std/float
import std/box::{Box}
import kilim/sdl::*
import kilim/sdl_canvas::{SdlCanvas, SdlClipboard}
import kilim/event::*
import kilim/widget::{Widget}
import kilim/ui::{Ui}
import kilim/timers::{Pacer}
import kilim/theme::*

# primary: Cmd on macOS, Ctrl elsewhere. Ctrl+Alt together means AltGr
# (that's how it arrives on Windows; Polish AltGr+C = ć, Hungarian AltGr+V = @): not a shortcut.
{% if flag?(:darwin) %}
  def primary_down?(mod : UInt16) : Bool
    mod & LibSDL3::KMOD_GUI != 0
  end
{% else %}
  def primary_down?(mod : UInt16) : Bool
    mod & LibSDL3::KMOD_CTRL != 0 && mod & LibSDL3::KMOD_ALT == 0
  end
{% end %}

pub class SdlWindow
  getter ui : Ui
  # Raw SDL_Window*; for SDL calls kilim does not bind.
  getter handle : Void*

  def initialize(title : String, width : Int32, height : Int32, root : Widget)
    sdl_fatal("SDL_Init") unless LibSDL3.SDL_Init(LibSDL3::INIT_VIDEO)
    sdl_fatal("TTF_Init") unless LibTTF.TTF_Init
    @handle = LibSDL3.SDL_CreateWindow(title, width, height, LibSDL3::WINDOW_RESIZABLE | LibSDL3::WINDOW_HIGH_PIXEL_DENSITY)
    sdl_fatal("SDL_CreateWindow") if @handle.address == 0
    @renderer = LibSDL3.SDL_CreateRenderer(@handle, Pointer(UInt8).new(0_u64))
    sdl_fatal("SDL_CreateRenderer") if @renderer.address == 0
    @canvas = SdlCanvas.new(@renderer, LibSDL3.SDL_GetWindowPixelDensity(@handle))
    @ui = Ui.new(root, @canvas, SdlClipboard.new)
    @event = LibSDL3::Event.new
    @quit = false
    @closed = false
    @text_input = false
    @pacer = Pacer.new
    # Every ivar must be filled before handing out self.
    @watch_box = Pointer(Void).new(0_u64)
    # Live resize: on Windows/macOS the event loop stalls during a drag,
    # but the SDL watch is called synchronously on every event. This is kilim's only
    # C -> iyi callback. Not a closure; the state is carried by userdata.
    @watch = ->(data : Void*, ev : LibSDL3::Event*) do
      t = ev.value.type
      if t == LibSDL3::EVENT_WINDOW_RESIZED || t == LibSDL3::EVENT_WINDOW_EXPOSED
        Box(SdlWindow).unbox(data).redraw
      end
      true
    end
    # shortcut: the watch is registered after the window (self can only be handed out
    # once all ivars are filled); the first window events the offscreen driver emits
    # inside SDL_CreateWindow miss the watch but stay in the queue and the loop handles them.
    # The box lives in this ivar: SDL's only copy is on the C side, invisible to the GC.
    @watch_box = Box.box(self)
    sdl_fatal("SDL_AddEventWatch") unless LibSDL3.SDL_AddEventWatch(@watch, @watch_box)
    relayout
  end

  # Waits for and handles events until closed, then closes.
  pub def run : Nil
    present
    until @quit
      wait = @pacer.wait_ms(clock_ms, @ui.wants_text_input?)
      got = wait < 0 ? LibSDL3.SDL_WaitEvent(pointerof(@event)) : LibSDL3.SDL_WaitEventTimeout(pointerof(@event), wait)
      handle_event if got
      now = clock_ms
      @ui.blink if @pacer.blink?(now, @ui.wants_text_input?, !got)
      @pacer.timers.fire(now)
      drain
      present
    end
    close
  end

  # Drains the queue without waiting and draws a frame if needed.
  pub def step : Nil
    @pacer.timers.fire(clock_ms)
    drain
    present
  end

  # Runs the block every ms milliseconds on the event loop (no threads); returns an id for cancel_timer.
  pub def every(ms : Int32, &fn : -> Nil) : Int32
    @pacer.timers.add(ms, true, clock_ms, &fn)
  end

  # Runs the block once, ms milliseconds from now; returns an id for cancel_timer.
  pub def after(ms : Int32, &fn : -> Nil) : Int32
    @pacer.timers.add(ms, false, clock_ms, &fn)
  end

  pub def cancel_timer(id : Int32) : Nil
    @pacer.timers.cancel(id)
  end

  def clock_ms : Int64
    LibSDL3.SDL_GetTicks.unsafe_to_i64
  end

  pub def inject(e : Event) : Nil
    @ui.dispatch(e)
  end

  # Redraws the whole window and saves it as a BMP. After Present the back
  # buffer is undefined, so it is redrawn first and then read.
  pub def screenshot(path : String) : Nil
    relayout
    @ui.frame
    surface = LibSDL3.SDL_RenderReadPixels(@renderer, Pointer(LibSDL3::Rect).new(0_u64))
    sdl_fatal("SDL_RenderReadPixels") if surface.address == 0
    ok = LibSDL3.SDL_SaveBMP(surface, path)
    LibSDL3.SDL_DestroySurface(surface)
    sdl_fatal("SDL_SaveBMP") unless ok
    LibSDL3.SDL_RenderPresent(@renderer)
  end

  pub def close : Nil
    return if @closed
    @closed = true
    LibSDL3.SDL_RemoveEventWatch(@watch, @watch_box)
    @canvas.close
    LibSDL3.SDL_DestroyRenderer(@renderer)
    LibSDL3.SDL_DestroyWindow(@handle)
    LibTTF.TTF_Quit
    LibSDL3.SDL_Quit
  end

  # From the watch: whatever the size, the whole window is redrawn.
  def redraw : Nil
    return if @closed
    relayout
    present
  end

  def present : Nil
    sync_text_input
    LibSDL3.SDL_RenderPresent(@renderer) if @ui.frame
  end

  # Hands the window's logical size to Ui (always requests a redraw).
  def relayout : Nil
    w = h = 0
    LibSDL3.SDL_GetWindowSize(@handle, pointerof(w), pointerof(h))
    @ui.resize(w.to_f32, h.to_f32)
  end

  def sync_text_input : Nil
    want = @ui.wants_text_input?
    return if want == @text_input
    @text_input = want
    if want
      LibSDL3.SDL_StartTextInput(@handle)
    else
      LibSDL3.SDL_StopTextInput(@handle)
    end
  end

  def drain : Nil
    while !@quit && LibSDL3.SDL_PollEvent(pointerof(@event))
      handle_event
    end
  end

  def handle_event : Nil
    ev = pointerof(@event)
    case ev.value.type
    when LibSDL3::EVENT_QUIT, LibSDL3::EVENT_WINDOW_CLOSE_REQUESTED
      @quit = true
    when LibSDL3::EVENT_WINDOW_PIXEL_SIZE_CHANGED, LibSDL3::EVENT_WINDOW_DISPLAY_SCALE_CHANGED
      d = LibSDL3.SDL_GetWindowPixelDensity(@handle)
      if d != @canvas.density
        @canvas.set_density(d)
        @ui.drop_caches
      end
      w = h = 0
      LibSDL3.SDL_GetWindowSize(@handle, pointerof(w), pointerof(h))
      @ui.dispatch Resize.new(w.to_f32, h.to_f32)
    when LibSDL3::EVENT_RENDER_DEVICE_RESET
      # The GPU device was recreated and its textures with it.
      @canvas.drop_textures
      relayout
    when LibSDL3::EVENT_MOUSE_MOTION
      m = ev.as(LibSDL3::MouseMotionEvent*).value
      @ui.dispatch MouseMove.new(m.x, m.y)
    when LibSDL3::EVENT_MOUSE_BUTTON_DOWN, LibSDL3::EVENT_MOUSE_BUTTON_UP
      b = ev.as(LibSDL3::MouseButtonEvent*).value
      if button = mouse_button(b.button)
        if b.down
          @ui.dispatch MouseDown.new(b.x, b.y, button)
        else
          @ui.dispatch MouseUp.new(b.x, b.y, button)
        end
      end
    when LibSDL3::EVENT_MOUSE_WHEEL
      wh = ev.as(LibSDL3::MouseWheelEvent*).value
      # When FLIPPED (macOS "natural scrolling"), y already arrives in the
      # direction the user chose; multiplying by -1 would reverse that preference.
      # If something needing the physical direction (e.g. zoom) appears, look at direction.
      @ui.dispatch Wheel.new(wh.mouse_x, wh.mouse_y, wh.y)
    when LibSDL3::EVENT_KEY_DOWN
      k = ev.as(LibSDL3::KeyboardEvent*).value
      mods = Mods.new(shift: k.mod & LibSDL3::KMOD_SHIFT != 0, primary: primary_down?(k.mod))
      @ui.dispatch KeyDown.new(key(k.key), mods)
    when LibSDL3::EVENT_TEXT_INPUT
      # Some platforms also send TEXT_INPUT for Ctrl/Cmd+C/V; that is a shortcut,
      # not text (with AltGr, primary_down? is false and the text passes).
      return if primary_down?(LibSDL3.SDL_GetModState)
      @ui.dispatch TextInput.new(c_string(ev.as(LibSDL3::TextInputEvent*).value.text))
    end
  end

  def mouse_button(b : UInt8) : MouseButton?
    case b
    when LibSDL3::BUTTON_LEFT   then MouseButton::Left
    when LibSDL3::BUTTON_RIGHT  then MouseButton::Right
    when LibSDL3::BUTTON_MIDDLE then MouseButton::Middle
    else                             nil
    end
  end

  def key(code : UInt32) : Key
    case code
    when LibSDL3::KEY_TAB                         then Key::Tab
    when LibSDL3::KEY_RETURN, LibSDL3::KEY_KP_ENTER then Key::Enter
    when LibSDL3::KEY_SPACE                       then Key::Space
    when LibSDL3::KEY_BACKSPACE                   then Key::Backspace
    when LibSDL3::KEY_DELETE                      then Key::Delete
    when LibSDL3::KEY_LEFT                        then Key::Left
    when LibSDL3::KEY_RIGHT                       then Key::Right
    when LibSDL3::KEY_HOME                        then Key::Home
    when LibSDL3::KEY_END                         then Key::End
    when LibSDL3::KEY_ESCAPE                      then Key::Escape
    when LibSDL3::KEY_C                           then Key::C
    when LibSDL3::KEY_V                           then Key::V
    else                                               Key::Other
    end
  end

  @renderer : Void*
  @canvas : SdlCanvas
  @event : LibSDL3::Event
  @quit : Bool
  @closed : Bool
  @text_input : Bool
  @pacer : Pacer
  @watch : LibSDL3::EventFilter
  @watch_box : Void*
end
