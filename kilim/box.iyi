# Row/column container. The cross axis is always stretch.

module kilim/box

import std/float
import std/indexable
import kilim/geom::{Rect, Size}
import kilim/canvas::{Canvas}
import kilim/widget::*

pub enum Axis
  Row
  Column
end

pub class Box < Widget
  def initialize(@axis : Axis, children : Array(Widget) = [] of Widget, @padding : Float32 = 0_f32, @spacing : Float32 = 0_f32, sizing : Sizing = Sizing.fit)
    @kids = [] of Widget
    self.sizing = sizing
    children.each { |w| add(w) }
  end

  pub def children : Array(Widget)
    @kids
  end

  pub def add(w : Widget) : Nil
    detach(w)
    @kids << w
    w.parent = self
    invalidate
  end

  pub def insert(i : Int32, w : Widget) : Nil
    detach(w)
    @kids.insert(i, w)
    w.parent = self
    invalidate
  end

  # If the widget is in another Box, remove it from there: it must not be in two child lists at once.
  def detach(w : Widget) : Nil
    if p = w.parent
      p.as(Box).remove(w) if p.is_a?(Box)
    end
  end

  pub def remove(w : Widget) : Nil
    if @kids.delete(w)
      w.parent = nil
    end
    invalidate
  end

  pub def clear : Nil
    @kids.each { |w| w.parent = nil }
    @kids.clear
    invalidate
  end

  pub def preferred(c : Canvas) : Size
    main = 0_f32
    cross = 0_f32
    @kids.each do |w|
      s = w.cached_preferred(c)
      m = w.sizing.mode.fixed? ? w.sizing.value : (@axis.row? ? s.w : s.h)
      x = @axis.row? ? s.h : s.w
      main += m
      cross = x if x > cross
    end
    gaps = @kids.size > 1 ? @spacing * (@kids.size - 1) : 0_f32
    main += gaps + 2 * @padding
    cross += 2 * @padding
    @axis.row? ? Size.new(main, cross) : Size.new(cross, main)
  end

  pub def layout(r : Rect, c : Canvas) : Nil
    @bounds = r
    inner = r.inset(@padding)
    row = @axis.row?
    inner_main = row ? inner.w : inner.h
    inner_cross = row ? inner.h : inner.w
    n = @kids.size
    used = 0_f32
    weights = 0_f32
    # Each child's main-axis size before Fill shares are known (Fill: 0); one preferred call per child.
    sizes = Array(Float32).new(n)
    @kids.each do |w|
      size = case w.sizing.mode
             when SizeMode::Fill  then 0_f32
             when SizeMode::Fixed then w.sizing.value
             else
               s = w.cached_preferred(c)
               row ? s.w : s.h
             end
      weights += w.sizing.value if w.sizing.mode.fill?
      used += size
      sizes << size
    end
    gaps = n > 1 ? @spacing * (n - 1) : 0_f32
    free = inner_main - used - gaps
    free = 0_f32 if free < 0
    pos = row ? inner.x : inner.y
    @kids.each_with_index do |w, i|
      size = w.sizing.mode.fill? ? (weights > 0 ? free * w.sizing.value / weights : 0_f32) : sizes[i]
      size = 0_f32 if size < 0
      if row
        w.layout(Rect.new(pos, inner.y, size, inner_cross), c)
      else
        w.layout(Rect.new(inner.x, pos, inner_cross, size), c)
      end
      pos += size + @spacing
    end
  end

  pub def draw(c : Canvas) : Nil
    # Children outside the clip (scrolled away) are skipped.
    @kids.each { |w| w.draw(c) if c.visible?(w.bounds) }
  end

  @kids : Array(Widget)
end
