# Event dispatch (hover/capture/focus) and frame (layout + drawing). Independent of SDL.

module kilim/ui

import std/float
import kilim/geom::{Rect}
import kilim/canvas::{Canvas}
import kilim/clipboard::{Clipboard}
import kilim/event::*
import kilim/widget::*
import kilim/theme::*

class Shortcut
  getter key : Key
  getter primary : Bool
  getter shift : Bool
  getter fn : -> Nil

  def initialize(@key : Key, @primary : Bool, @shift : Bool, @fn : -> Nil)
  end
end

pub class Ui < Context
  getter hovered : Widget? = nil
  getter captured : Widget? = nil
  getter focused : Widget? = nil
  getter clipboard : Clipboard

  def initialize(@root : Widget, @canvas : Canvas, @clipboard : Clipboard)
    @shortcuts = [] of Shortcut
    @w = 0_f32
    @h = 0_f32
    @mx = 0_f32
    @my = 0_f32
    @mouse = false
    @root.needs_frame = true
  end

  pub def resize(w : Float32, h : Float32) : Nil
    @w = w
    @h = h
    @root.needs_frame = true
  end

  # After a font size or pixel density change: every widget measures again.
  pub def drop_caches : Nil
    @root.drop_caches
    @root.needs_frame = true
  end

  pub def needs_frame? : Bool
    @root.needs_frame
  end

  # Does layout + drawing if needed; true if it drew.
  pub def frame : Bool
    return false unless @root.needs_frame
    @root.needs_frame = false
    @root.layout(Rect.new(0_f32, 0_f32, @w, @h), @canvas)
    # Content moved under a resting pointer; draw already shows the right hover.
    if @mouse
      set_hover(@root.hit(@mx, @my))
      @root.needs_frame = false
    end
    @canvas.fill_rect(Rect.new(0_f32, 0_f32, @w, @h), BG)
    @root.draw(@canvas)
    true
  end

  pub def focus(w : Widget?) : Nil
    w = nil if w && !w.focusable?
    return if w == @focused
    if o = @focused
      o.focused = false
      o.focus_changed
    end
    @focused = w
    if n = w
      n.focused = true
      n.focus_changed
    end
    @root.needs_frame = true
  end

  # Is there a widget with text input focus (Window turns SDL text input on and off).
  pub def wants_text_input? : Bool
    if f = @focused
      return f.wants_text_input?
    end
    false
  end

  # The focused widget's caret, if it has one.
  pub def caret_rect : Rect?
    if f = @focused
      return f.caret_rect
    end
    nil
  end

  # Window calls this every BLINK_MS; it only affects the focused widget.
  pub def blink : Nil
    if f = @focused
      f.blink
    end
  end

  # Runs the block on a matching KeyDown, which then never reaches the focused
  # widget. With primary: false it applies only while no text field is focused.
  pub def shortcut(key : Key, primary : Bool = true, shift : Bool = false, &fn : -> Nil) : Nil
    @shortcuts << Shortcut.new(key, primary, shift, fn)
  end

  def run_shortcut(e : KeyDown) : Bool
    return false if !e.mods.primary && wants_text_input?
    s = @shortcuts.find { |c| c.key == e.key && c.primary == e.mods.primary && c.shift == e.mods.shift }
    return false unless s
    s.fn.call
    true
  end

  pub def dispatch(e : Event) : Nil
    sanitize
    case e
    when MouseMove
      remember(e.x, e.y)
      set_hover(@root.hit(e.x, e.y))
    when MouseDown
      remember(e.x, e.y)
      set_hover(@root.hit(e.x, e.y))
      # The first widget that handles the event gets capture; MouseUp goes to it.
      @captured = bubble(@hovered, e)
      focus(focus_target(@hovered))
    when MouseUp
      if c = @captured
        c.handle(e, self)
        @captured = nil
      end
    when Wheel
      remember(e.x, e.y)
      bubble(@root.hit(e.x, e.y), e)
    when KeyDown, TextInput
      if e.is_a?(KeyDown) && run_shortcut(e)
      elsif e.is_a?(KeyDown) && e.key.tab?
        move_focus(e.mods.shift ? -1 : 1)
      elsif f = @focused
        f.handle(e, self)
      end
    when Resize
      resize(e.w, e.h)
    end
    sanitize
  end

  # The target or its nearest focusable ancestor.
  def focus_target(start : Widget?) : Widget?
    w = start
    while w
      return w if w.focusable?
      w = w.parent
    end
    nil
  end

  # DFS order is recomputed every time; wraps at the ends.
  def move_focus(dir : Int32) : Nil
    order = [] of Widget
    collect(@root, order)
    return if order.empty?
    i = nil
    if f = @focused
      i = order.index(f)
    end
    n = order.size
    j = i ? (i + dir) % n : (dir > 0 ? 0 : n - 1)
    j += n if j < 0
    focus(order[j])
    order[j].reveal
  end

  def collect(w : Widget, acc : Array(Widget)) : Nil
    acc << w if w.focusable?
    w.children.each { |k| collect(k, acc) }
  end

  # Freezes the chain before the event starts: iteration stays intact even if a handler changes the tree.
  # Returns the widget that handled the event.
  def bubble(start : Widget?, e : Event) : Widget?
    chain = [] of Widget
    w = start
    while w
      chain << w
      w = w.parent
    end
    chain.each do |x|
      return x if x.handle(e, self)
    end
    nil
  end

  def remember(x : Float32, y : Float32) : Nil
    @mx = x
    @my = y
    @mouse = true
  end

  def set_hover(w : Widget?) : Nil
    return if w == @hovered
    if o = @hovered
      o.hovered = false
    end
    @hovered = w
    if n = w
      n.hovered = true
    end
    @root.needs_frame = true
  end

  # Widgets detached from the tree must not stay in hover/capture/focus.
  def sanitize : Nil
    if h = @hovered
      unless h.attached_to?(@root)
        h.hovered = false
        @hovered = nil
        @root.needs_frame = true
        # The next frame re-hits the resting pointer once the layout is fresh.
      end
    end
    if c = @captured
      unless c.attached_to?(@root)
        c.pressed = false
        @captured = nil
      end
    end
    if f = @focused
      unless f.attached_to?(@root)
        f.focused = false
        @focused = nil
      end
    end
  end

  @root : Widget
  @mx : Float32
  @my : Float32
  @mouse : Bool
  @canvas : Canvas
  @w : Float32
  @h : Float32
end
