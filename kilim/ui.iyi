# Event dispatch (hover/capture/focus) and frame (layout + drawing). Independent of SDL.

module kilim/ui

import std/float
import kilim/geom::{Rect}
import kilim/canvas::{Canvas}
import kilim/clipboard::{Clipboard}
import kilim/event::*
import kilim/widget::*
import kilim/theme::*

pub class Ui < Context
  getter hovered : Widget? = nil
  getter captured : Widget? = nil
  getter focused : Widget? = nil
  getter clipboard : Clipboard

  def initialize(@root : Widget, @canvas : Canvas, @clipboard : Clipboard)
    @w = 0_f32
    @h = 0_f32
    @root.needs_frame = true
  end

  pub def resize(w : Float32, h : Float32) : Nil
    @w = w
    @h = h
    @root.needs_frame = true
  end

  pub def needs_frame? : Bool
    @root.needs_frame
  end

  # Does layout + drawing if needed; true if it drew.
  pub def frame : Bool
    return false unless @root.needs_frame
    @root.needs_frame = false
    @root.layout(Rect.new(0_f32, 0_f32, @w, @h), @canvas)
    @canvas.fill_rect(Rect.new(0_f32, 0_f32, @w, @h), BG)
    @root.draw(@canvas)
    true
  end

  pub def focus(w : Widget?) : Nil
    w = nil if w && !w.focusable?
    return if w == @focused
    if o = @focused
      o.focused = false
      o.focus_changed
    end
    @focused = w
    if n = w
      n.focused = true
      n.focus_changed
    end
    @root.needs_frame = true
  end

  # Is there a widget with text input focus (Window turns SDL text input on and off).
  pub def wants_text_input? : Bool
    if f = @focused
      return f.wants_text_input?
    end
    false
  end

  # Window calls this every BLINK_MS; it only affects the focused widget.
  pub def blink : Nil
    if f = @focused
      f.blink
    end
  end

  pub def dispatch(e : Event) : Nil
    sanitize
    case e
    when MouseMove
      set_hover(@root.hit(e.x, e.y))
    when MouseDown
      set_hover(@root.hit(e.x, e.y))
      # The first widget that handles the event gets capture; MouseUp goes to it.
      @captured = bubble(@hovered, e)
      focus(focus_target(@hovered))
    when MouseUp
      if c = @captured
        c.handle(e, self)
        @captured = nil
      end
    when Wheel
      bubble(@root.hit(e.x, e.y), e)
    when KeyDown, TextInput
      if e.is_a?(KeyDown) && e.key.tab?
        move_focus(e.mods.shift ? -1 : 1)
      elsif f = @focused
        f.handle(e, self)
      end
    when Resize
      resize(e.w, e.h)
    end
    sanitize
  end

  # The target or its nearest focusable ancestor.
  def focus_target(start : Widget?) : Widget?
    w = start
    while w
      return w if w.focusable?
      w = w.parent
    end
    nil
  end

  # DFS order is recomputed every time; wraps at the ends.
  def move_focus(dir : Int32) : Nil
    order = [] of Widget
    collect(@root, order)
    return if order.empty?
    i = nil
    if f = @focused
      i = order.index(f)
    end
    n = order.size
    j = i ? (i + dir) % n : (dir > 0 ? 0 : n - 1)
    j += n if j < 0
    focus(order[j])
  end

  def collect(w : Widget, acc : Array(Widget)) : Nil
    acc << w if w.focusable?
    w.children.each { |k| collect(k, acc) }
  end

  # Freezes the chain before the event starts: iteration stays intact even if a handler changes the tree.
  # Returns the widget that handled the event.
  def bubble(start : Widget?, e : Event) : Widget?
    chain = [] of Widget
    w = start
    while w
      chain << w
      w = w.parent
    end
    chain.each do |x|
      return x if x.handle(e, self)
    end
    nil
  end

  def set_hover(w : Widget?) : Nil
    return if w == @hovered
    if o = @hovered
      o.hovered = false
    end
    @hovered = w
    if n = w
      n.hovered = true
    end
    @root.needs_frame = true
  end

  # Widgets detached from the tree must not stay in hover/capture/focus.
  def sanitize : Nil
    if h = @hovered
      unless h.attached_to?(@root)
        h.hovered = false
        @hovered = nil
        @root.needs_frame = true
      end
    end
    if c = @captured
      unless c.attached_to?(@root)
        c.pressed = false
        @captured = nil
      end
    end
    if f = @focused
      unless f.attached_to?(@root)
        f.focused = false
        @focused = nil
      end
    end
  end

  @root : Widget
  @canvas : Canvas
  @w : Float32
  @h : Float32
end
