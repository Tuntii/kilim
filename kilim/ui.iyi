# Event dispatch (hover/capture/focus) and frame (layout + drawing). Independent of SDL.

module kilim/ui

import std/float
import kilim/geom::{Rect}
import kilim/canvas::{Canvas}
import kilim/clipboard::{Clipboard}
import kilim/event::*
import kilim/widget::*
import kilim/theme::*

class Shortcut
  getter key : Key
  getter primary : Bool
  getter shift : Bool
  getter fn : -> Nil

  def initialize(@key : Key, @primary : Bool, @shift : Bool, @fn : -> Nil)
  end
end

pub class Ui < Context
  getter hovered : Widget? = nil
  getter captured : Widget? = nil
  getter focused : Widget? = nil
  getter clipboard : Clipboard
  getter overlay : Widget? = nil
  getter modal : Widget? = nil

  def initialize(@root : Widget, @canvas : Canvas, @clipboard : Clipboard)
    @shortcuts = [] of Shortcut
    @w = 0_f32
    @h = 0_f32
    @mx = 0_f32
    @my = 0_f32
    @mouse = false
    @root.needs_frame = true
  end

  pub def resize(w : Float32, h : Float32) : Nil
    @w = w
    @h = h
    # The popup is anchored to a rect that the new layout moves.
    hide_overlay
    @root.needs_frame = true
  end

  # After a font size or pixel density change: every widget measures again.
  pub def drop_caches : Nil
    @root.drop_caches
    @root.needs_frame = true
  end

  pub def needs_frame? : Bool
    return true if @root.needs_frame
    if m = @modal
      return true if m.needs_frame
    end
    if o = @overlay
      return o.needs_frame
    end
    false
  end

  # Replaces a modal already shown. Any popup goes: it belonged to the tree underneath.
  pub def show_modal(w : Widget) : Nil
    close_modal if @modal
    hide_overlay
    @modal_prev = @focused
    @modal = w
    @root.needs_frame = true
  end

  pub def close_modal : Nil
    return unless m = @modal
    @modal = nil
    m.needs_frame = false
    if o = @overlay
      if w = o.owner
        hide_overlay if w.attached_to?(m)
      end
    end
    prev = @modal_prev
    @modal_prev = nil
    # Back to where the user was, unless that widget left the tree meanwhile.
    focus(prev && prev.attached_to?(@root) ? prev : nil)
    @root.needs_frame = true
    sanitize
  end

  pub def show_overlay(w : Widget, below : Rect) : Nil
    hide_overlay
    @overlay = w
    @anchor = below
    @root.needs_frame = true
  end

  pub def hide_overlay : Nil
    if o = @overlay
      o.needs_frame = false
      @overlay = nil
      @root.needs_frame = true
      # Hover/capture inside it are dropped by sanitize.
    end
  end

  # The overlay is on top, then the modal; with a modal up the root is out of reach.
  def hit_at(x : Float32, y : Float32) : Widget?
    if o = @overlay
      if h = o.hit(x, y)
        return h
      end
    end
    if m = @modal
      return m.hit(x, y)
    end
    @root.hit(x, y)
  end

  def layout_modal : Nil
    return unless m = @modal
    s = m.cached_preferred(@canvas)
    w = s.w < @w ? s.w : @w
    h = s.h < @h ? s.h : @h
    m.layout(Rect.new((@w - w) / 2, (@h - h) / 2, w, h), @canvas)
  end

  def layout_overlay : Nil
    return unless o = @overlay
    s = o.cached_preferred(@canvas)
    a = @anchor
    w = s.w > a.w ? s.w : a.w
    y = a.y + a.h
    y = a.y - s.h if y + s.h > @h && a.y - s.h >= 0
    x = a.x
    x = @w - w if x + w > @w
    x = 0_f32 if x < 0
    o.layout(Rect.new(x, y, w, s.h), @canvas)
  end

  # Does layout + drawing if needed; true if it drew.
  pub def frame : Bool
    return false unless needs_frame?
    @root.needs_frame = false
    @root.layout(Rect.new(0_f32, 0_f32, @w, @h), @canvas)
    layout_modal
    layout_overlay
    # Content moved under a resting pointer; draw already shows the right hover.
    if @mouse
      set_hover(hit_at(@mx, @my))
      @root.needs_frame = false
    end
    if m = @modal
      m.needs_frame = false
    end
    if o = @overlay
      o.needs_frame = false
    end
    @canvas.fill_rect(Rect.new(0_f32, 0_f32, @w, @h), BG)
    @root.draw(@canvas)
    if m = @modal
      @canvas.fill_rect(Rect.new(0_f32, 0_f32, @w, @h), SCRIM)
      m.draw(@canvas)
    end
    if o = @overlay
      o.draw(@canvas)
    end
    true
  end

  pub def focus(w : Widget?) : Nil
    w = nil if w && !w.focusable?
    return if w == @focused
    if o = @focused
      o.focused = false
      o.focus_changed
    end
    @focused = w
    if n = w
      n.focused = true
      n.focus_changed
    end
    @root.needs_frame = true
  end

  # Is there a widget with text input focus (Window turns SDL text input on and off).
  pub def wants_text_input? : Bool
    if f = @focused
      return f.wants_text_input?
    end
    false
  end

  # The focused widget's caret, if it has one.
  pub def caret_rect : Rect?
    if f = @focused
      return f.caret_rect
    end
    nil
  end

  # Window calls this every BLINK_MS; it only affects the focused widget.
  pub def blink : Nil
    if f = @focused
      f.blink
    end
  end

  # Runs the block on a matching KeyDown, which then never reaches the focused
  # widget. With primary: false it applies only while no text field is focused.
  pub def shortcut(key : Key, primary : Bool = true, shift : Bool = false, &fn : -> Nil) : Nil
    @shortcuts << Shortcut.new(key, primary, shift, fn)
  end

  def run_shortcut(e : KeyDown) : Bool
    return false if @modal
    return false if !e.mods.primary && wants_text_input?
    s = @shortcuts.find { |c| c.key == e.key && c.primary == e.mods.primary && c.shift == e.mods.shift }
    return false unless s
    s.fn.call
    true
  end

  pub def dispatch(e : Event) : Nil
    sanitize
    case e
    when MouseMove
      remember(e.x, e.y)
      set_hover(hit_at(e.x, e.y))
      # A held button means a drag: the capturing widget follows the pointer.
      if c = @captured
        c.handle(e, self)
      end
    when MouseDown
      remember(e.x, e.y)
      set_hover(hit_at(e.x, e.y))
      if @overlay && !(@hovered && in_overlay?(@hovered))
        # Outside the popup: it closes and the click goes no further.
        hide_overlay
      elsif @modal && !(@hovered && (in_modal?(@hovered) || in_overlay?(@hovered)))
        # The dimmed window: nothing happens, focus stays.
      else
        # The first widget that handles the event gets capture; MouseUp goes to it.
        @captured = bubble(@hovered, e)
        # Popup rows are not focus targets: the owner keeps focus.
        focus(focus_target(@hovered)) unless in_overlay?(@hovered)
      end
    when MouseUp
      if c = @captured
        c.handle(e, self)
        @captured = nil
      end
    when Wheel
      remember(e.x, e.y)
      if @overlay
        # Scrolling would leave the popup behind its owner: close it, and swallow the wheel.
        hide_overlay
      else
        bubble(@modal ? hit_at(e.x, e.y) : @root.hit(e.x, e.y), e)
      end
    when KeyDown, TextInput
      if e.is_a?(KeyDown) && e.key.escape? && @overlay
        hide_overlay
      elsif e.is_a?(KeyDown) && run_shortcut(e)
      elsif e.is_a?(KeyDown) && e.key.tab?
        move_focus(e.mods.shift ? -1 : 1)
      else
        handled = false
        if f = @focused
          handled = f.handle(e, self)
        end
        # Escape / Enter that the focused widget left alone belong to the modal.
        if !handled && e.is_a?(KeyDown)
          if m = @modal
            m.handle(e, self)
          end
        end
      end
    when Resize
      resize(e.w, e.h)
    end
    sanitize
  end

  def in_overlay?(w : Widget?) : Bool
    return false unless w
    if o = @overlay
      return w.attached_to?(o)
    end
    false
  end

  def in_modal?(w : Widget?) : Bool
    return false unless w
    if m = @modal
      return w.attached_to?(m)
    end
    false
  end

  # In the root tree, the modal's or the overlay's.
  def live?(w : Widget) : Bool
    w.attached_to?(@root) || in_modal?(w) || in_overlay?(w)
  end

  # The target or its nearest focusable ancestor.
  def focus_target(start : Widget?) : Widget?
    w = start
    while w
      return w if w.focusable?
      w = w.parent
    end
    nil
  end

  # DFS order is recomputed every time; wraps at the ends.
  def move_focus(dir : Int32) : Nil
    order = [] of Widget
    collect(@modal || @root, order)
    return if order.empty?
    i = nil
    if f = @focused
      i = order.index(f)
    end
    n = order.size
    j = i ? (i + dir) % n : (dir > 0 ? 0 : n - 1)
    j += n if j < 0
    focus(order[j])
    order[j].reveal
  end

  def collect(w : Widget, acc : Array(Widget)) : Nil
    acc << w if w.focusable?
    w.children.each { |k| collect(k, acc) }
  end

  # Freezes the chain before the event starts: iteration stays intact even if a handler changes the tree.
  # Returns the widget that handled the event.
  def bubble(start : Widget?, e : Event) : Widget?
    chain = [] of Widget
    w = start
    while w
      chain << w
      w = w.parent
    end
    chain.each do |x|
      return x if x.handle(e, self)
    end
    nil
  end

  def remember(x : Float32, y : Float32) : Nil
    @mx = x
    @my = y
    @mouse = true
  end

  def set_hover(w : Widget?) : Nil
    return if w == @hovered
    if o = @hovered
      o.hovered = false
    end
    @hovered = w
    if n = w
      n.hovered = true
    end
    @root.needs_frame = true
  end

  # Widgets detached from the tree must not stay in hover/capture/focus.
  def sanitize : Nil
    if h = @hovered
      unless live?(h)
        h.hovered = false
        @hovered = nil
        @root.needs_frame = true
        # The next frame re-hits the resting pointer once the layout is fresh.
      end
    end
    if c = @captured
      unless live?(c)
        c.pressed = false
        @captured = nil
      end
    end
    if f = @focused
      unless f.attached_to?(@root) || in_modal?(f)
        f.focused = false
        @focused = nil
      end
    end
    if o = @overlay
      if w = o.owner
        hide_overlay unless w.attached_to?(@root) || in_modal?(w)
      end
    end
    # Added to a tree from outside: it is no longer a root of its own.
    if m = @modal
      close_modal if m.parent
    end
  end

  @root : Widget
  @modal_prev : Widget? = nil
  @anchor : Rect = Rect.new(0_f32, 0_f32, 0_f32, 0_f32)
  @mx : Float32
  @my : Float32
  @mouse : Bool
  @canvas : Canvas
  @w : Float32
  @h : Float32
end
