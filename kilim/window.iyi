# The platform window. On Windows it is the native backend (Win32 + Direct2D +
# DirectWrite) unless the program is built with `-Dsdl`; elsewhere it is SDL3.
# shortcut: iyi cannot re-export a class under a short name, so Window subclasses
# the chosen backend; once `pub alias` works across modules, alias it instead.

module kilim/window

{% if flag?(:win32) && !flag?(:sdl) %}
  import kilim/win_window::{WinWindow}

  pub BACKEND = "win32"

  pub class Window < WinWindow
  end
{% else %}
  import kilim/sdl_window::{SdlWindow}

  pub BACKEND = "sdl"

  pub class Window < SdlWindow
  end
{% end %}
