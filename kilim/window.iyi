# SDL penceresi ve olay döngüsü. SDL olaylarını kilim olaylarına çevirip
# Ui'ye verir; Ui çizdiyse ekrana basar.

module kilim/window

import std/float
import std/box::{Box}
import kilim/sdl::*
import kilim/sdl_canvas::{SdlCanvas, SdlClipboard}
import kilim/event::*
import kilim/widget::{Widget}
import kilim/ui::{Ui}
import kilim/theme::*

# primary: macOS'ta Cmd, diğerlerinde Ctrl. Ctrl+Alt birlikteyse AltGr'dir
# (Windows'ta böyle gelir; Lehçe AltGr+C = ć, Macarca AltGr+V = @): kısayol değil.
{% if flag?(:darwin) %}
  def primary_down?(mod : UInt16) : Bool
    mod & LibSDL3::KMOD_GUI != 0
  end
{% else %}
  def primary_down?(mod : UInt16) : Bool
    mod & LibSDL3::KMOD_CTRL != 0 && mod & LibSDL3::KMOD_ALT == 0
  end
{% end %}

pub class Window
  getter ui : Ui
  # Ham SDL_Window*; kilim'in bağlamadığı SDL çağrıları için.
  getter handle : Void*

  def initialize(title : String, width : Int32, height : Int32, root : Widget)
    sdl_fatal("SDL_Init") unless LibSDL3.SDL_Init(LibSDL3::INIT_VIDEO)
    sdl_fatal("TTF_Init") unless LibTTF.TTF_Init
    @handle = LibSDL3.SDL_CreateWindow(title, width, height, LibSDL3::WINDOW_RESIZABLE | LibSDL3::WINDOW_HIGH_PIXEL_DENSITY)
    sdl_fatal("SDL_CreateWindow") if @handle.address == 0
    @renderer = LibSDL3.SDL_CreateRenderer(@handle, Pointer(UInt8).new(0_u64))
    sdl_fatal("SDL_CreateRenderer") if @renderer.address == 0
    @canvas = SdlCanvas.new(@renderer, LibSDL3.SDL_GetWindowPixelDensity(@handle))
    @ui = Ui.new(root, @canvas, SdlClipboard.new)
    @event = LibSDL3::Event.new
    @quit = false
    @closed = false
    @text_input = false
    # self'i vermeden önce her ivar dolu olmalı.
    @watch_box = Pointer(Void).new(0_u64)
    # Canlı resize: Windows/macOS'ta sürükleme sırasında olay döngüsü durur,
    # ama SDL watch'ı her olayda eşzamanlı çağırır. Kilim'in tek C -> iyi
    # callback'i budur. Closure değil; durumu userdata taşır.
    @watch = ->(data : Void*, ev : LibSDL3::Event*) do
      t = ev.value.type
      if t == LibSDL3::EVENT_WINDOW_RESIZED || t == LibSDL3::EVENT_WINDOW_EXPOSED
        Box(Window).unbox(data).redraw
      end
      true
    end
    # shortcut: watch pencereden sonra kaydedilir (self ancak tüm ivar'lar
    # dolunca verilebilir); offscreen sürücüsünün SDL_CreateWindow içindeki
    # ilk pencere olayları watch'a uğramaz ama kuyrukta kalır ve döngü işler.
    # Kutu bu ivar'da yaşar: SDL'in elindeki tek kopya C tarafında, GC görmez.
    @watch_box = Box.box(self)
    sdl_fatal("SDL_AddEventWatch") unless LibSDL3.SDL_AddEventWatch(@watch, @watch_box)
    relayout
  end

  # Kapatılana kadar olayları bekler ve işler, sonra kapatır.
  pub def run : Nil
    present
    until @quit
      if @ui.wants_text_input?
        if LibSDL3.SDL_WaitEventTimeout(pointerof(@event), BLINK_MS)
          handle_event
        else
          @ui.blink
        end
      elsif LibSDL3.SDL_WaitEvent(pointerof(@event))
        handle_event
      end
      drain
      present
    end
    close
  end

  # Beklemeden kuyruğu boşaltır ve gerekiyorsa bir frame çizer.
  pub def step : Nil
    drain
    present
  end

  pub def inject(e : Event) : Nil
    @ui.dispatch(e)
  end

  # Tüm pencereyi yeniden çizip BMP olarak kaydeder. Present'ten sonra arka
  # tampon tanımsız olduğu için önce yeniden çizilir, sonra okunur.
  pub def screenshot(path : String) : Nil
    relayout
    @ui.frame
    surface = LibSDL3.SDL_RenderReadPixels(@renderer, Pointer(LibSDL3::Rect).new(0_u64))
    sdl_fatal("SDL_RenderReadPixels") if surface.address == 0
    ok = LibSDL3.SDL_SaveBMP(surface, path)
    LibSDL3.SDL_DestroySurface(surface)
    sdl_fatal("SDL_SaveBMP") unless ok
    LibSDL3.SDL_RenderPresent(@renderer)
  end

  pub def close : Nil
    return if @closed
    @closed = true
    LibSDL3.SDL_RemoveEventWatch(@watch, @watch_box)
    @canvas.close
    LibSDL3.SDL_DestroyRenderer(@renderer)
    LibSDL3.SDL_DestroyWindow(@handle)
    LibTTF.TTF_Quit
    LibSDL3.SDL_Quit
  end

  # Watch'tan: boyut ne olursa olsun tüm pencere yeniden çizilir.
  def redraw : Nil
    return if @closed
    relayout
    present
  end

  def present : Nil
    sync_text_input
    LibSDL3.SDL_RenderPresent(@renderer) if @ui.frame
  end

  # Pencerenin mantıksal boyutunu Ui'ye verir (her zaman yeniden çizim ister).
  def relayout : Nil
    w = h = 0
    LibSDL3.SDL_GetWindowSize(@handle, pointerof(w), pointerof(h))
    @ui.resize(w.to_f32, h.to_f32)
  end

  def sync_text_input : Nil
    want = @ui.wants_text_input?
    return if want == @text_input
    @text_input = want
    if want
      LibSDL3.SDL_StartTextInput(@handle)
    else
      LibSDL3.SDL_StopTextInput(@handle)
    end
  end

  def drain : Nil
    while !@quit && LibSDL3.SDL_PollEvent(pointerof(@event))
      handle_event
    end
  end

  def handle_event : Nil
    ev = pointerof(@event)
    case ev.value.type
    when LibSDL3::EVENT_QUIT, LibSDL3::EVENT_WINDOW_CLOSE_REQUESTED
      @quit = true
    when LibSDL3::EVENT_WINDOW_PIXEL_SIZE_CHANGED, LibSDL3::EVENT_WINDOW_DISPLAY_SCALE_CHANGED
      @canvas.set_density(LibSDL3.SDL_GetWindowPixelDensity(@handle))
      w = h = 0
      LibSDL3.SDL_GetWindowSize(@handle, pointerof(w), pointerof(h))
      @ui.dispatch Resize.new(w.to_f32, h.to_f32)
    when LibSDL3::EVENT_MOUSE_MOTION
      m = ev.as(LibSDL3::MouseMotionEvent*).value
      @ui.dispatch MouseMove.new(m.x, m.y)
    when LibSDL3::EVENT_MOUSE_BUTTON_DOWN, LibSDL3::EVENT_MOUSE_BUTTON_UP
      b = ev.as(LibSDL3::MouseButtonEvent*).value
      if button = mouse_button(b.button)
        if b.down
          @ui.dispatch MouseDown.new(b.x, b.y, button)
        else
          @ui.dispatch MouseUp.new(b.x, b.y, button)
        end
      end
    when LibSDL3::EVENT_MOUSE_WHEEL
      wh = ev.as(LibSDL3::MouseWheelEvent*).value
      # FLIPPED (macOS "doğal kaydırma") olduğunda y zaten kullanıcının
      # seçtiği yönde gelir; -1 ile çarpmak o tercihi tersine çevirirdi.
      # Fiziksel yön gereken bir şey (ör. zoom) çıkarsa direction'a bakılır.
      @ui.dispatch Wheel.new(wh.mouse_x, wh.mouse_y, wh.y)
    when LibSDL3::EVENT_KEY_DOWN
      k = ev.as(LibSDL3::KeyboardEvent*).value
      mods = Mods.new(shift: k.mod & LibSDL3::KMOD_SHIFT != 0, primary: primary_down?(k.mod))
      @ui.dispatch KeyDown.new(key(k.key), mods)
    when LibSDL3::EVENT_TEXT_INPUT
      # Bazı platformlar Ctrl/Cmd+C/V için de TEXT_INPUT yollar; o kısayoldur,
      # metin değil (AltGr ise primary_down? false verir, metin geçer).
      return if primary_down?(LibSDL3.SDL_GetModState)
      @ui.dispatch TextInput.new(c_string(ev.as(LibSDL3::TextInputEvent*).value.text))
    end
  end

  def mouse_button(b : UInt8) : MouseButton?
    case b
    when LibSDL3::BUTTON_LEFT   then MouseButton::Left
    when LibSDL3::BUTTON_RIGHT  then MouseButton::Right
    when LibSDL3::BUTTON_MIDDLE then MouseButton::Middle
    else                             nil
    end
  end

  def key(code : UInt32) : Key
    case code
    when LibSDL3::KEY_TAB                         then Key::Tab
    when LibSDL3::KEY_RETURN, LibSDL3::KEY_KP_ENTER then Key::Enter
    when LibSDL3::KEY_SPACE                       then Key::Space
    when LibSDL3::KEY_BACKSPACE                   then Key::Backspace
    when LibSDL3::KEY_DELETE                      then Key::Delete
    when LibSDL3::KEY_LEFT                        then Key::Left
    when LibSDL3::KEY_RIGHT                       then Key::Right
    when LibSDL3::KEY_HOME                        then Key::Home
    when LibSDL3::KEY_END                         then Key::End
    when LibSDL3::KEY_ESCAPE                      then Key::Escape
    when LibSDL3::KEY_C                           then Key::C
    when LibSDL3::KEY_V                           then Key::V
    else                                               Key::Other
    end
  end

  @renderer : Void*
  @canvas : SdlCanvas
  @event : LibSDL3::Event
  @quit : Bool
  @closed : Bool
  @text_input : Bool
  @watch : LibSDL3::EventFilter
  @watch_box : Void*
end
