# Single-line text editing model. The cursor is a character index (not a byte).

module kilim/text_edit

import std/indexable
import kilim/canvas::{Canvas}

pub class TextEdit
  getter cursor : Int32 = 0
  getter anchor : Int32? = nil

  def initialize
    @chars = [] of Char
  end

  pub def text : String
    join(0, @chars.size)
  end

  # Text to the left of the cursor.
  pub def before_cursor : String
    join(0, @cursor)
  end

  pub def size : Int32
    @chars.size
  end

  pub def set(s : String) : Nil
    @chars.clear
    s.each_char { |ch| @chars << ch }
    @cursor = @chars.size
    @anchor = nil
  end

  pub def insert(s : String) : Nil
    delete_selection
    # One splice: inserting character by character is O(n²) for a large paste.
    add = [] of Char
    s.each_char { |ch| add << ch }
    @chars[@cursor, 0] = add
    @cursor += add.size
  end

  pub def backspace : Nil
    return if delete_selection
    return if @cursor == 0
    @cursor -= 1
    @chars.delete_at(@cursor)
  end

  pub def delete : Nil
    return if delete_selection
    return if @cursor >= @chars.size
    @chars.delete_at(@cursor)
  end

  # (start, end) with start < end; nil when nothing is selected.
  pub def selection : Tuple(Int32, Int32)?
    if a = @anchor
      return nil if a == @cursor
      return a < @cursor ? {a, @cursor} : {@cursor, a}
    end
    nil
  end

  pub def selected_text : String
    if s = selection
      return join(s[0], s[1])
    end
    ""
  end

  # Text of the first n characters.
  pub def prefix(n : Int32) : String
    join(0, n)
  end

  # Moves the cursor; with `grow` the selection grows from where it started.
  pub def move_to(i : Int32, grow : Bool) : Nil
    i = 0 if i < 0
    i = @chars.size if i > @chars.size
    if grow
      @anchor = @cursor if @anchor.nil?
    else
      @anchor = nil
    end
    @cursor = i
  end

  pub def select_all : Nil
    @anchor = 0
    @cursor = @chars.size
  end

  pub def delete_selection : Bool
    s = selection
    @anchor = nil
    return false unless s
    @chars[s[0], s[1] - s[0]] = [] of Char
    @cursor = s[0]
    true
  end

  # Without Shift, a selection collapses to its near edge instead of moving.
  pub def left(grow : Bool = false) : Nil
    if !grow && (s = selection)
      move_to(s[0], false)
    else
      move_to(@cursor - 1, grow)
    end
  end

  pub def right(grow : Bool = false) : Nil
    if !grow && (s = selection)
      move_to(s[1], false)
    else
      move_to(@cursor + 1, grow)
    end
  end

  pub def home(grow : Bool = false) : Nil
    move_to(0, grow)
  end

  pub def end_(grow : Bool = false) : Nil
    move_to(@chars.size, grow)
  end

  # The index in [from, upto] whose x, measured from the character at from, is nearest x
  # (binary search over prefix widths).
  pub def index_near(c : Canvas, from : Int32, upto : Int32, x : Float32) : Int32
    lo = from
    hi = upto
    while lo < hi
      mid = (lo + hi) // 2
      if c.measure(join(from, mid)).w < x
        lo = mid + 1
      else
        hi = mid
      end
    end
    if lo > from && x - c.measure(join(from, lo - 1)).w < c.measure(join(from, lo)).w - x
      lo -= 1
    end
    lo
  end

  # Text of characters [from, upto).
  pub def join(from : Int32, upto : Int32) : String
    String.build do |b|
      i = from
      while i < upto
        b << @chars[i]
        i += 1
      end
    end
  end

  @chars : Array(Char)
end
