# Vertical scroll container; shows its single child through a clip.

module kilim/scroll

import std/float
import kilim/geom::{Rect, Size}
import kilim/canvas::{Canvas}
import kilim/event::*
import kilim/widget::*
import kilim/theme::*

pub class Scroll < Widget
  getter offset : Float32 = 0_f32
  @content_h : Float32 = 0_f32

  def initialize(@child : Widget)
    @child.parent = self
    self.sizing = Sizing.fill
  end

  pub def children : Array(Widget)
    [@child] of Widget
  end

  pub def preferred(c : Canvas) : Size
    Size.new(@child.cached_preferred(c).w + SCROLLBAR_W, CONTROL_H)
  end

  pub def layout(r : Rect, c : Canvas) : Nil
    @bounds = r
    @canvas = c
    @content_h = @child.cached_preferred(c).h
    clamp
    place_child(c)
  end

  def place_child(c : Canvas) : Nil
    r = @bounds
    @child.layout(Rect.new(r.x, r.y - @offset, (r.w > SCROLLBAR_W ? r.w - SCROLLBAR_W : 0_f32), @content_h), c)
  end

  # Scrolls the least amount that makes r (screen coordinates) fully visible; the top wins if r is taller.
  pub def reveal(r : Rect) : Nil
    d = 0_f32
    d = r.y + r.h - (@bounds.y + @bounds.h) if r.y + r.h > @bounds.y + @bounds.h
    d = r.y - @bounds.y if r.y - d < @bounds.y
    scroll_by(d)
  end

  # Moves the content and, unlike a plain invalidate, lays it out at once: hit-testing
  # (hover after a wheel step, a Tab that reveals) must see the new positions before the next frame.
  def scroll_by(d : Float32) : Bool
    old = @offset
    @offset += d
    clamp
    return false if @offset == old
    invalidate
    if c = @canvas
      place_child(c)
    end
    true
  end

  pub def handle(e : Event, ui : Context) : Bool
    return false unless e.is_a?(Wheel)
    # At a limit the step is not ours: bubble lets an outer Scroll take it.
    scroll_by(-e.dy * WHEEL_STEP)
  end

  pub def draw(c : Canvas) : Nil
    c.push_clip(@bounds)
    @child.draw(c)
    c.pop_clip
    range = @content_h - @bounds.h
    if range > 0
      th = @bounds.h * @bounds.h / @content_h
      ty = @bounds.y + @offset / range * (@bounds.h - th)
      c.fill_rect(Rect.new(@bounds.x + @bounds.w - SCROLLBAR_W, ty, SCROLLBAR_W, th), SCROLLBAR)
    end
  end

  # Children outside the visible area (scrolled away) cannot be hit.
  pub def hit(x : Float32, y : Float32) : Widget?
    return nil unless @bounds.contains?(x, y)
    @child.hit(x, y) || self
  end

  def clamp : Nil
    max = @content_h - @bounds.h
    max = 0_f32 if max < 0
    @offset = max if @offset > max
    @offset = 0_f32 if @offset < 0
  end

  @child : Widget
  @canvas : Canvas? = nil
end
