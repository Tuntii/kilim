# SDL3/SDL3_ttf implementation of Canvas and Clipboard. Callers pass logical
# units; here they are converted to pixels with `density`, and text is also
# rasterized at that density (sharp on Retina).

module kilim/sdl_canvas

import std/float
import kilim/sdl::*
import kilim/geom::{Rect, Size}
import kilim/canvas::{Canvas, Color}
import kilim/clipboard::{Clipboard}
import kilim/theme::*

# Font embedded in the program (Noto Sans Regular, OFL: assets/fonts/OFL.txt).
FONT_DATA = {{ read_file("#{__DIR__}/../assets/fonts/NotoSans-Regular.ttf") }}

# A rasterized string, reused until evicted.
struct TextTexture
  getter texture : Void*
  getter w : Float32
  getter h : Float32

  def initialize(@texture : Void*, @w : Float32, @h : Float32)
  end
end

# shortcut: both caches are cleared whole when full (no LRU); a frame needs far fewer
# entries than the limits, so this only costs a re-measure/re-raster burst while scrolling.
MEASURE_CACHE_MAX = 4096
TEXT_CACHE_MAX    = 1024

pub class SdlCanvas < Canvas
  getter density : Float32

  def initialize(@renderer : Void*, @density : Float32)
    io = LibSDL3.SDL_IOFromConstMem(FONT_DATA.to_unsafe.as(Void*), FONT_DATA.bytesize.to_u64)
    sdl_fatal("SDL_IOFromConstMem") if io.address == 0
    @font = LibTTF.TTF_OpenFontIO(io, true, FONT_SIZE * @density)
    sdl_fatal("TTF_OpenFontIO") if @font.address == 0
    @clips = [] of Rect
    @sizes = {} of String => Size
    @textures = {} of Tuple(String, UInt8, UInt8, UInt8, UInt8) => TextTexture
    LibSDL3.SDL_SetRenderDrawBlendMode(@renderer, LibSDL3::BLENDMODE_BLEND)
  end

  # When the window moves to a display with a different density.
  pub def set_density(d : Float32) : Nil
    return if d == @density
    @density = d
    LibTTF.TTF_SetFontSize(@font, FONT_SIZE * d)
    @sizes.clear
    drop_textures
  end

  # Textures cached so far are gone; e.g. after SDL reports a render device reset.
  pub def drop_textures : Nil
    @textures.each_value { |t| LibSDL3.SDL_DestroyTexture(t.texture) }
    @textures.clear
  end

  pub def fill_rect(r : Rect, c : Color) : Nil
    color(c)
    fr = frect(r)
    LibSDL3.SDL_RenderFillRect(@renderer, pointerof(fr))
  end

  pub def stroke_rect(r : Rect, c : Color) : Nil
    color(c)
    fr = frect(r)
    LibSDL3.SDL_RenderRect(@renderer, pointerof(fr))
  end

  pub def line(x1 : Float32, y1 : Float32, x2 : Float32, y2 : Float32, c : Color) : Nil
    color(c)
    d = @density
    LibSDL3.SDL_RenderLine(@renderer, x1 * d, y1 * d, x2 * d, y2 * d)
  end

  pub def text(x : Float32, y : Float32, s : String, c : Color) : Nil
    return if s.empty? || @font.address == 0
    key = {s, c.r, c.g, c.b, c.a}
    t = @textures[key]?
    unless t
      surface = LibTTF.TTF_RenderText_Blended(@font, s.to_unsafe, s.bytesize.to_u64, sdl_color(c))
      return if surface.address == 0
      texture = LibSDL3.SDL_CreateTextureFromSurface(@renderer, surface)
      LibSDL3.SDL_DestroySurface(surface)
      return if texture.address == 0
      w = h = 0_f32
      LibSDL3.SDL_GetTextureSize(texture, pointerof(w), pointerof(h))
      drop_textures if @textures.size >= TEXT_CACHE_MAX
      t = TextTexture.new(texture, w, h)
      @textures[key] = t
    end
    # Rounded to whole pixels: at a fractional position the texture gets filtered and the text blurs.
    dst = LibSDL3::FRect.new(x: (x * @density).round, y: (y * @density).round, w: t.w, h: t.h)
    LibSDL3.SDL_RenderTexture(@renderer, t.texture, Pointer(LibSDL3::FRect).new(0_u64), pointerof(dst))
  end

  pub def measure(s : String) : Size
    if m = @sizes[s]?
      return m
    end
    w = h = 0
    LibTTF.TTF_GetStringSize(@font, s.to_unsafe, s.bytesize.to_u64, pointerof(w), pointerof(h))
    m = Size.new(w / @density, h / @density)
    @sizes.clear if @sizes.size >= MEASURE_CACHE_MAX
    @sizes[s] = m
    m
  end

  pub def line_height : Float32
    LibTTF.TTF_GetFontHeight(@font) / @density
  end

  pub def push_clip(r : Rect) : Nil
    @clips << (@clips.empty? ? r : @clips.last.intersect(r))
    apply_clip
  end

  pub def pop_clip : Nil
    @clips.pop unless @clips.empty?
    apply_clip
  end

  # Without a clip: the renderer's output, in logical units.
  pub def visible?(r : Rect) : Bool
    return r.overlaps?(@clips.last) unless @clips.empty?
    w = h = 0
    LibSDL3.SDL_GetCurrentRenderOutputSize(@renderer, pointerof(w), pointerof(h))
    r.overlaps?(Rect.new(0_f32, 0_f32, w / @density, h / @density))
  end

  # Before the renderer is destroyed: the textures belong to it.
  pub def close : Nil
    drop_textures
    return if @font.address == 0
    LibTTF.TTF_CloseFont(@font)
    @font = Pointer(Void).new(0_u64)
  end

  def apply_clip : Nil
    if @clips.empty?
      LibSDL3.SDL_SetRenderClipRect(@renderer, Pointer(LibSDL3::Rect).new(0_u64))
      return
    end
    r = @clips.last
    d = @density
    # Rounded outward: a half pixel at the edge must not be clipped.
    x0 = (r.x * d).floor
    y0 = (r.y * d).floor
    x1 = ((r.x + r.w) * d).ceil
    y1 = ((r.y + r.h) * d).ceil
    pr = LibSDL3::Rect.new(x: x0.to_i, y: y0.to_i, w: (x1 - x0).to_i, h: (y1 - y0).to_i)
    LibSDL3.SDL_SetRenderClipRect(@renderer, pointerof(pr))
  end

  def frect(r : Rect) : LibSDL3::FRect
    d = @density
    LibSDL3::FRect.new(x: r.x * d, y: r.y * d, w: r.w * d, h: r.h * d)
  end

  def color(c : Color) : Nil
    LibSDL3.SDL_SetRenderDrawColor(@renderer, c.r, c.g, c.b, c.a)
  end

  def sdl_color(c : Color) : LibSDL3::Color
    LibSDL3::Color.new(r: c.r, g: c.g, b: c.b, a: c.a)
  end

  @renderer : Void*
  @font : Void*
  @clips : Array(Rect)
  @sizes : Hash(String, Size)
  @textures : Hash(Tuple(String, UInt8, UInt8, UInt8, UInt8), TextTexture)
end

pub class SdlClipboard < Clipboard
  pub def get : String
    ptr = LibSDL3.SDL_GetClipboardText
    return "" if ptr.address == 0
    s = c_string(ptr)
    LibSDL3.SDL_free(ptr.as(Void*))
    s
  end

  pub def set(s : String) : Bool
    LibSDL3.SDL_SetClipboardText(s)
  end
end
