# Widget base and sizing types.

module kilim/widget

import kilim/geom::{Rect, Size}
import kilim/canvas::{Canvas}
import kilim/event::{Event}
import kilim/clipboard::{Clipboard}

pub enum SizeMode
  Fit
  Fixed
  Fill
end

pub struct Sizing
  getter mode : SizeMode
  getter value : Float32

  def initialize(@mode : SizeMode, @value : Float32 = 0_f32)
  end

  pub def self.fit : Sizing
    Sizing.new(SizeMode::Fit)
  end

  pub def self.fixed(v : Float32) : Sizing
    Sizing.new(SizeMode::Fixed, v)
  end

  # value = weight.
  pub def self.fill(weight : Float32 = 1.0_f32) : Sizing
    Sizing.new(SizeMode::Fill, weight)
  end
end

pub abstract class Widget
  property bounds : Rect = Rect.new(0, 0, 0, 0)
  property parent : Widget? = nil
  property sizing : Sizing = Sizing.fit
  # Only Ui writes this.
  property hovered : Bool = false
  property pressed : Bool = false
  property focused : Bool = false
  # Meaningful at the root.
  property needs_frame : Bool = false

  pub def children : Array(Widget)
    [] of Widget
  end

  pub abstract def preferred(c : Canvas) : Size
  pub abstract def draw(c : Canvas) : Nil

  pub def layout(r : Rect, c : Canvas) : Nil
    @bounds = r
  end

  pub def focusable? : Bool
    false
  end

  pub def handle(e : Event, ui : Context) : Bool
    false
  end

  # Does the focused widget expect text input (for IME/on-screen keyboard).
  pub def wants_text_input? : Bool
    false
  end

  # Ui calls this when focus changes and on the blink timer.
  pub def focus_changed : Nil
  end

  pub def blink : Nil
  end

  pub def root : Widget
    w = self
    while p = w.parent
      w = p
    end
    w
  end

  pub def invalidate : Nil
    root.needs_frame = true
  end

  # The deepest widget hit; children are checked from last to first (topmost first).
  pub def hit(x : Float32, y : Float32) : Widget?
    return nil unless @bounds.contains?(x, y)
    kids = children
    i = kids.size - 1
    while i >= 0
      if h = kids[i].hit(x, y)
        return h
      end
      i -= 1
    end
    self
  end

  pub def attached_to?(r : Widget) : Bool
    root == r
  end
end

# The surface widgets need from Ui. Ui implements it (avoids a widget -> ui cycle).
pub abstract class Context
  pub abstract def clipboard : Clipboard
  pub abstract def focused : Widget?
  pub abstract def focus(w : Widget?) : Nil
end
