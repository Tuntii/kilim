# Single-line text box; scrolling keeps the caret visible.

module kilim/textbox

import std/float
import kilim/geom::{Rect, Size}
import kilim/canvas::{Canvas}
import kilim/event::*
import kilim/widget::*
import kilim/theme::*
import kilim/text_edit::{TextEdit}

pub class Textbox < Widget
  property caret_visible : Bool = true
  getter scroll_x : Float32 = 0_f32

  def initialize(@placeholder : String = "", text : String = "", @on_change : (String -> Nil)? = nil, @on_submit : (String -> Nil)? = nil)
    @edit = TextEdit.new
    @edit.set(text)
    @canvas = nil
    @last = text
    @sizing = Sizing.fill
  end

  pub def text : String
    @edit.text
  end

  pub def text=(s : String) : Nil
    @edit.set(s)
    # Not a user edit: remember the text so the next real edit compares against it.
    @last = @edit.text
    changed
  end

  pub def focusable? : Bool
    true
  end

  pub def wants_text_input? : Bool
    true
  end

  pub def focus_changed : Nil
    @caret_visible = true
  end

  pub def blink : Nil
    @caret_visible = !@caret_visible
    invalidate
  end

  pub def preferred(c : Canvas) : Size
    Size.new(TEXTBOX_MIN_W, CONTROL_H)
  end

  pub def layout(r : Rect, c : Canvas) : Nil
    @bounds = r
    @canvas = c
    adjust_scroll
  end

  pub def draw(c : Canvas) : Nil
    c.fill_rect(bounds, BUTTON_BG)
    c.stroke_rect(bounds, focused ? FOCUS_RING : BORDER)
    ty = bounds.y + (bounds.h - c.line_height) / 2
    c.push_clip(bounds.inset(PADDING / 2))
    if sel = @edit.selection
      x0 = bounds.x + PADDING - @scroll_x
      xa = x0 + c.measure(@edit.prefix(sel[0])).w
      xb = x0 + c.measure(@edit.prefix(sel[1])).w
      c.fill_rect(Rect.new(xa, ty, xb - xa, c.line_height), SELECTION)
    end
    if @edit.size == 0
      c.text(bounds.x + PADDING, ty, @placeholder, MUTED)
    else
      c.text(bounds.x + PADDING - @scroll_x, ty, @edit.text, FG)
    end
    if focused && @caret_visible
      r = caret_at(c)
      c.line(r.x, r.y, r.x, r.y + r.h, FG)
    end
    c.pop_clip
  end

  pub def caret_rect : Rect?
    if c = @canvas
      return caret_at(c)
    end
    nil
  end

  def caret_at(c : Canvas) : Rect
    ty = bounds.y + (bounds.h - c.line_height) / 2
    Rect.new(bounds.x + PADDING + c.measure(@edit.before_cursor).w - @scroll_x, ty, 1_f32, c.line_height)
  end

  # The caret index nearest to logical x (binary search over prefix widths).
  pub def index_at(x : Float32) : Int32
    c = @canvas
    return 0 unless c
    @edit.index_near(c, 0, @edit.size, x - bounds.x - PADDING + @scroll_x)
  end

  pub def handle(e : Event, ui : Context) : Bool
    case e
    when MouseDown
      return false unless e.button.left?
      @edit.move_to(index_at(e.x), false)
      changed
      true
    when MouseMove
      @edit.move_to(index_at(e.x), true)
      changed
      true
    when MouseUp
      true
    when TextInput
      @edit.insert(e.text)
      changed
      true
    when KeyDown
      case e.key
      when Key::Backspace
        @edit.backspace
      when Key::Delete
        @edit.delete
      when Key::Left
        @edit.left(e.mods.shift)
      when Key::Right
        @edit.right(e.mods.shift)
      when Key::Home
        @edit.home(e.mods.shift)
      when Key::End
        @edit.end_(e.mods.shift)
      when Key::Enter
        if f = @on_submit
          f.call(@edit.text)
        end
        return true
      when Key::C
        return false unless e.mods.primary
        ui.clipboard.set(@edit.selected_text) if @edit.selection
        return true
      when Key::X
        return false unless e.mods.primary
        return true unless @edit.selection
        ui.clipboard.set(@edit.selected_text)
        @edit.delete_selection
      when Key::A
        return false unless e.mods.primary
        @edit.select_all
      when Key::V
        return false unless e.mods.primary
        @edit.insert(one_line(ui.clipboard.get))
      else
        return false
      end
      changed
      true
    else
      false
    end
  end

  # After every edit: caret visible, scroll fixed up, on_change (if the text changed).
  def changed : Nil
    @caret_visible = true
    adjust_scroll
    invalidate
    t = @edit.text
    return if t == @last
    @last = t
    if f = @on_change
      f.call(t)
    end
  end

  # The caret x stays within [bounds.x + PADDING, bounds.right - PADDING].
  def adjust_scroll : Nil
    c = @canvas
    return unless c
    cx = PADDING + c.measure(@edit.before_cursor).w
    right = bounds.w - PADDING
    @scroll_x = cx - right if cx - @scroll_x > right
    @scroll_x = cx - PADDING if cx - @scroll_x < PADDING
    @scroll_x = 0_f32 if @scroll_x < 0
  end

  # "\r\n" and "\n" become a single space.
  def one_line(s : String) : String
    cs = [] of Char
    s.each_char { |ch| cs << ch }
    String.build do |b|
      i = 0
      while i < cs.size
        ch = cs[i]
        if ch == '\r' && i + 1 < cs.size && cs[i + 1] == '\n'
          i += 1
          b << ' '
        elsif ch == '\r' || ch == '\n'
          b << ' '
        else
          b << ch
        end
        i += 1
      end
    end
  end

  @placeholder : String
  @on_change : (String -> Nil)?
  @on_submit : (String -> Nil)?
  @edit : TextEdit
  @canvas : Canvas?
  @last : String
end
