# Textbox: giriş, pano, imleç görünürlüğü, Ui entegrasyonu.

module test/textbox_test

import std/float
import kilim/event::*
import kilim/widget::*
import kilim/box::*
import kilim/ui::{Ui}
import kilim/button::{Button}
import kilim/textbox::{Textbox}
import kilim/theme::*
import kilim/testing::*

class Log
  property changes : Int32 = 0
  property submitted : String = ""
end

def key(ui : Ui, k : Key, primary : Bool = false) : Nil
  ui.dispatch KeyDown.new(k, Mods.new(false, primary))
end

def main : Int32
  lg = Log.new
  tb = Textbox.new("ara", "", ->(s : String) { lg.changes += 1; nil }, ->(s : String) { lg.submitted = s; nil })
  btn = Button.new("x")
  col = Box.new(Axis::Column, [tb, btn] of Widget)
  rc = RecordCanvas.new
  mem = MemoryClipboard.new
  ui = Ui.new(col, rc, mem)
  ui.resize(120_f32, 200_f32)
  ui.frame

  expect !ui.wants_text_input?, "odak yokken false"
  ui.focus(tb)
  expect ui.wants_text_input?, "textbox odakta"

  # placeholder
  tb.caret_visible = true
  rc.calls.clear
  ui.focus(btn)
  ui.focus(tb)
  ui.frame
  expect rc.calls.any? { |c| c.ends_with?(",ara") }, "boşken placeholder çizilir"
  expect rc.calls.any? { |c| c.starts_with?("clip") }, "push_clip"

  s = "Çalışma şöğüt ılık İzmir"
  ui.dispatch TextInput.new(s)
  expect_eq tb.text, s, "TextInput eklenir"
  expect_eq lg.changes, 1, "on_change çağrıldı"
  key(ui, Key::Enter)
  expect_eq lg.submitted, s, "Enter -> on_submit"

  key(ui, Key::C, true)
  expect_eq mem.get, s, "primary+C panoya"
  key(ui, Key::C)
  mem.set("a\nb")
  key(ui, Key::V, true)
  expect_eq tb.text, s + "a b", "primary+V satır sonu boşluk"
  mem.set("c\r\nd")
  key(ui, Key::V, true)
  expect tb.text.ends_with?("c d"), "CRLF tek boşluk"

  key(ui, Key::Backspace)
  key(ui, Key::Home)
  key(ui, Key::Delete)
  expect tb.text.starts_with?("alışma"), "Home + Delete, Ç tek karakter"

  # imleç görünür kalır
  tb2 = Textbox.new
  ui2 = Ui.new(Box.new(Axis::Column, [tb2] of Widget), rc, mem)
  ui2.resize(120_f32, 100_f32)
  ui2.frame
  ui2.focus(tb2)
  ui2.dispatch TextInput.new("abcdefghijklmnopqrstuvwxyzabcdefghijklmn")
  ui2.frame
  caret_x = tb2.bounds.x + PADDING + rc.measure("abcdefghijklmnopqrstuvwxyzabcdefghijklmn").w - tb2.scroll_x
  expect caret_x <= tb2.bounds.x + tb2.bounds.w - PADDING, "imleç görünür"
  expect caret_x >= tb2.bounds.x + PADDING, "imleç solda taşmaz"
  ui2.dispatch KeyDown.new(Key::Home, Mods.new)
  expect_eq tb2.scroll_x, 0_f32, "Home -> scroll_x 0"

  # blink ve odak
  ui2.blink
  expect !tb2.caret_visible, "blink gizler"
  ui2.blink
  expect tb2.caret_visible, "blink gösterir"
  ui2.blink
  ui2.focus(nil)
  expect !ui2.wants_text_input?, "odak gidince false"
  ui2.focus(tb2)
  expect tb2.caret_visible, "odak değişince caret görünür"
  ui2.dispatch TextInput.new("z")
  ui2.blink
  ui2.dispatch TextInput.new("y")
  expect tb2.caret_visible, "yazınca caret görünür"

  puts "textbox ok"
  0
end

exit main
