# Textbox: input, clipboard, caret visibility, Ui integration.

module test/textbox_test

import std/float
import kilim/event::*
import kilim/widget::*
import kilim/box::*
import kilim/ui::{Ui}
import kilim/button::{Button}
import kilim/textbox::{Textbox}
import kilim/theme::*
import kilim/testing::*

class Log
  property changes : Int32 = 0
  property submitted : String = ""
end

def key(ui : Ui, k : Key, primary : Bool = false) : Nil
  ui.dispatch KeyDown.new(k, Mods.new(false, primary))
end

def main : Int32
  lg = Log.new
  tb = Textbox.new("search", "", ->(s : String) { lg.changes += 1; nil }, ->(s : String) { lg.submitted = s; nil })
  btn = Button.new("x")
  col = Box.new(Axis::Column, [tb, btn] of Widget)
  rc = RecordCanvas.new
  mem = MemoryClipboard.new
  ui = Ui.new(col, rc, mem)
  ui.resize(120_f32, 200_f32)
  ui.frame

  expect !ui.wants_text_input?, "false when nothing is focused"
  ui.focus(tb)
  expect ui.wants_text_input?, "textbox focused"

  # placeholder
  tb.caret_visible = true
  rc.calls.clear
  ui.focus(btn)
  ui.focus(tb)
  ui.frame
  expect rc.calls.any? { |c| c.ends_with?(",search") }, "placeholder is drawn when empty"
  expect rc.calls.any? { |c| c.starts_with?("clip") }, "push_clip"

  s = "Çalışma şöğüt ılık İzmir"
  ui.dispatch TextInput.new(s)
  expect_eq tb.text, s, "TextInput is inserted"
  expect_eq lg.changes, 1, "on_change called"
  key(ui, Key::Enter)
  expect_eq lg.submitted, s, "Enter -> on_submit"

  key(ui, Key::C, true)
  expect_eq mem.get, "", "primary+C without a selection leaves the clipboard alone"
  key(ui, Key::A, true)
  key(ui, Key::C, true)
  expect_eq mem.get, s, "select all, then primary+C copies everything"
  key(ui, Key::End)
  key(ui, Key::C)
  mem.set("a\nb")
  key(ui, Key::V, true)
  expect_eq tb.text, s + "a b", "primary+V line break becomes a space"
  mem.set("c\r\nd")
  key(ui, Key::V, true)
  expect tb.text.ends_with?("c d"), "CRLF becomes a single space"

  key(ui, Key::Backspace)
  key(ui, Key::Home)
  key(ui, Key::Delete)
  expect tb.text.starts_with?("alışma"), "Home + Delete, Ç is a single character"

  # mouse selection (8 px per character)
  tb3 = Textbox.new("", "abcdefgh")
  ui3 = Ui.new(Box.new(Axis::Column, [tb3] of Widget), rc, mem)
  ui3.resize(200_f32, 100_f32)
  ui3.frame
  x0 = tb3.bounds.x + PADDING
  y0 = tb3.bounds.y + 5_f32
  ui3.dispatch MouseDown.new(x0 + 8 * 3 + 2, y0, MouseButton::Left)
  ui3.dispatch MouseUp.new(x0 + 8 * 3 + 2, y0, MouseButton::Left)
  ui3.dispatch TextInput.new("X")
  expect_eq tb3.text, "abcXdefgh", "click puts the caret at 3"
  expect_eq tb3.index_at(x0 - 50_f32), 0, "index_at clamps left"
  expect_eq tb3.index_at(x0 + 500_f32), 9, "index_at clamps right"
  ui3.dispatch MouseDown.new(x0 + 8 + 1, y0, MouseButton::Left)
  ui3.dispatch MouseMove.new(x0 + 8 * 4 + 1, y0)
  ui3.dispatch MouseUp.new(x0 + 8 * 4 + 1, y0, MouseButton::Left)
  mem.set("")
  key(ui3, Key::X, true)
  expect_eq mem.get, "bcX", "drag from 1 to 4 selects 3 characters; primary+X cuts them"
  expect_eq tb3.text, "adefgh", "cut removes the selection"
  # A clipboard that refuses the text (another program holds it): the cut keeps the text.
  key(ui3, Key::A, true)
  mem.fail = true
  key(ui3, Key::X, true)
  mem.fail = false
  expect_eq tb3.text, "adefgh", "a failed clipboard write cuts nothing"
  mem.set("zz")
  key(ui3, Key::A, true)
  ui3.dispatch TextInput.new("q")
  expect_eq tb3.text, "q", "typing replaces the selection"
  key(ui3, Key::V, true)
  expect_eq tb3.text, "qzz", "paste"
  ui3.dispatch KeyDown.new(Key::Left, Mods.new(true, false))
  ui3.dispatch KeyDown.new(Key::Left, Mods.new(true, false))
  key(ui3, Key::V, true)
  expect_eq tb3.text, "qzz", "paste replaces the selection"

  # caret stays visible
  tb2 = Textbox.new
  ui2 = Ui.new(Box.new(Axis::Column, [tb2] of Widget), rc, mem)
  ui2.resize(120_f32, 100_f32)
  ui2.frame
  ui2.focus(tb2)
  ui2.dispatch TextInput.new("abcdefghijklmnopqrstuvwxyzabcdefghijklmn")
  ui2.frame
  caret_x = tb2.bounds.x + PADDING + rc.measure("abcdefghijklmnopqrstuvwxyzabcdefghijklmn").w - tb2.scroll_x
  expect caret_x <= tb2.bounds.x + tb2.bounds.w - PADDING, "caret visible"
  expect caret_x >= tb2.bounds.x + PADDING, "caret does not overflow on the left"
  if r = ui2.caret_rect
    expect_eq r.x, caret_x, "Ui#caret_rect is the scrolled caret (IME position)"
    expect_eq r.h, rc.line_height, "caret is one line high"
  else
    expect false, "a focused textbox has a caret_rect"
  end
  ui2.dispatch KeyDown.new(Key::Home, Mods.new)
  expect_eq tb2.scroll_x, 0_f32, "Home -> scroll_x 0"
  if r = ui2.caret_rect
    expect_eq r.x, tb2.bounds.x + PADDING, "caret_rect follows Home"
  end

  # blink and focus
  ui2.blink
  expect !tb2.caret_visible, "blink hides"
  ui2.blink
  expect tb2.caret_visible, "blink shows"
  ui2.blink
  ui2.focus(nil)
  expect !ui2.wants_text_input?, "false once focus is gone"
  expect ui2.caret_rect.nil?, "no caret_rect without focus"
  ui2.focus(tb2)
  expect tb2.caret_visible, "caret visible when focus changes"
  ui2.dispatch TextInput.new("z")
  ui2.blink
  ui2.dispatch TextInput.new("y")
  expect tb2.caret_visible, "caret visible when typing"

  # Programmatic text= is not a user edit: no on_change, but typing afterwards still counts.
  before = lg.changes
  tb.text = "x"
  expect_eq tb.text, "x", "text= sets"
  expect_eq lg.changes, before, "text= does not call on_change"
  ui.focus(tb)
  ui.dispatch TextInput.new("y")
  expect_eq lg.changes, before + 1, "typing after text= still calls on_change"

  puts "textbox ok"
  0
end

exit main
