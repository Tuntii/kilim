# TextEdit: character-indexed cursor, Turkish characters.

module test/text_edit_test

import kilim/text_edit::{TextEdit}
import kilim/testing::*

def main : Int32
  e = TextEdit.new
  e.insert("şöğüt")
  expect_eq e.cursor, 5, "character count, not bytes"
  e.backspace
  expect_eq e.text, "şöğü", "multi-byte character is deleted in one go"
  e.home
  e.delete
  expect_eq e.text, "öğü", "delete from the start"
  e.home
  e.left
  expect_eq e.cursor, 0, "stays at the boundary"
  e.insert("İ")
  e.end_
  e.insert("ı")
  expect_eq e.text, "İöğüı", "capital İ and dotless ı"
  e.end_
  e.right
  e.delete
  expect_eq e.cursor, 5, "right boundary"
  e.set("Çş")
  expect_eq e.cursor, 2, "set moves the cursor to the end"
  e.left
  e.insert("a")
  expect_eq e.text, "Çaş", "insert in the middle"
  expect_eq e.before_cursor, "Ça", "up to the cursor"
  e.home
  e.backspace
  expect_eq e.text, "Çaş", "backspace at start has no effect"

  # selection: indices are characters
  e.set("ş😀A")
  expect e.selection.nil?, "no selection after set"
  e.left(true)
  e.left(true)
  expect_eq e.selected_text, "😀A", "Shift+Left twice selects two characters"
  expect_eq e.anchor, 3, "anchor stays where selecting began"
  e.insert("x")
  expect_eq e.text, "şx", "typing replaces the selection"
  e.select_all
  expect_eq e.selected_text, "şx", "select_all"
  e.backspace
  expect_eq e.text, "", "backspace deletes the selection"
  e.set("abcd")
  e.left(true)
  e.left(true)
  e.left
  expect_eq e.cursor, 2, "Left collapses to the selection start"
  expect e.selection.nil?, "collapsed"
  e.right(true)
  e.right
  expect_eq e.cursor, 3, "Right collapses to the selection end"
  e.move_to(1, false)
  e.move_to(3, true)
  expect_eq e.selected_text, "bc", "move_to extends"
  expect e.delete_selection, "delete_selection reports a change"
  expect !e.delete_selection, "nothing left to delete"
  expect_eq e.text, "ad", "selection removed"
  e.home(true)
  expect_eq e.selected_text, "a", "Shift+Home"
  e.end_(true)
  expect_eq e.selected_text, "d", "anchor kept, Shift+End"
  puts "text_edit ok"
  0
end

exit main
