# Box: row/column layout, Fill share, no negative sizes.

module test/layout_test

import std/float
import kilim/geom::{Rect, Size}
import kilim/canvas::{Canvas, Color}
import kilim/widget::*
import kilim/box::*
import kilim/testing::*

class Dummy < Widget
  def initialize(@w : Float32 = 40, @h : Float32 = 20)
  end

  def preferred(c : Canvas) : Size
    Size.new(@w, @h)
  end

  def draw(c : Canvas) : Nil
  end
end

# What Widget#hit does, spelled out: the reference for Box's binary search.
def linear_hit(b : Box, x : Float32, y : Float32) : Widget?
  return nil unless b.bounds.contains?(x, y)
  kids = b.children
  i = kids.size - 1
  while i >= 0
    if h = kids[i].hit(x, y)
      return h
    end
    i -= 1
  end
  b
end

def check_hits(axis : Axis, n : Int32) : Nil
  kids = [] of Widget
  n.times do |i|
    d = Dummy.new(40_f32, 20_f32)
    # A few zero-size and varying children: the search must skip them like the scan does.
    d.sizing = Sizing.fixed(i % 97 == 0 ? 0_f32 : 12_f32 + (i % 5))
    kids << d
  end
  box = Box.new(axis, kids, 4_f32, 3_f32)
  rc = RecordCanvas.new
  box.layout(Rect.new(10_f32, 20_f32, 100_f32, 100_f32 + n * 17_f32), rc)
  seed = 12345_u32
  span = n * 17_f32 + 150_f32
  100.times do
    seed = seed &* 1103515245_u32 &+ 12345_u32
    a = ((seed >> 8) % 100000_u32).to_f32 / 100000_f32
    seed = seed &* 1103515245_u32 &+ 12345_u32
    c = ((seed >> 8) % 100000_u32).to_f32 / 100000_f32
    main = a * span - 20_f32
    cross = c * 140_f32 - 10_f32
    x = axis.row? ? main + 10_f32 : cross
    y = axis.row? ? cross + 20_f32 : main
    expect box.hit(x, y) == linear_hit(box, x, y), "binary search matches the linear scan at #{x},#{y}"
  end
end

def main : Int32
  rc = RecordCanvas.new

  check_hits(Axis::Column, 10000)
  check_hits(Axis::Row, 2000)

  # Column: Fixed(20) + Fill + Fill, padding 10, spacing 5
  a = Dummy.new
  a.sizing = Sizing.fixed(20)
  b = Dummy.new
  b.sizing = Sizing.fill
  c = Dummy.new
  c.sizing = Sizing.fill
  col = Box.new(Axis::Column, [a, b, c] of Widget, 10, 5)
  col.layout(Rect.new(0, 0, 200, 200), rc)
  expect a.bounds.x == 10 && a.bounds.y == 10 && a.bounds.w == 180 && a.bounds.h == 20, "fixed"
  expect_eq b.bounds.h, 75_f32, "fill share: (180-20-10)/2"
  expect_eq b.bounds.y, 35_f32, "b y"
  expect_eq c.bounds.y, 115_f32, "order + spacing"
  expect_eq c.bounds.w, 180_f32, "cross-axis stretch"

  # Row, Fit
  d1 = Dummy.new
  d2 = Dummy.new
  d3 = Dummy.new
  row = Box.new(Axis::Row, [d1, d2, d3] of Widget, 0, 4)
  p = row.preferred(rc)
  expect p.w == 40 * 3 + 4 * 2 && p.h == 20, "row fit preferred"
  row.layout(Rect.new(0, 0, 300, 50), rc)
  expect_eq d2.bounds.x, 44_f32, "row x"
  expect_eq d2.bounds.h, 50_f32, "row stretch"

  # Parent management
  expect_eq d1.parent, row, "parent set"
  row.remove(d1)
  expect d1.parent.nil?, "parent cleared"
  expect_eq row.children.size, 2, "remove"
  row.insert(0, d1)
  expect_eq row.children[0], d1, "insert"
  row.needs_frame = false
  row.add(Dummy.new)
  expect row.needs_frame, "add invalidates"
  row.clear
  expect_eq row.children.size, 0, "clear"

  # Zero rect
  z = Box.new(Axis::Column, [Dummy.new, Dummy.new] of Widget, 10, 5)
  zf = Dummy.new
  zf.sizing = Sizing.fill
  z.add(zf)
  z.layout(Rect.new(0, 0, 0, 0), rc)
  z.children.each { |w| expect w.bounds.w >= 0 && w.bounds.h >= 0, "no negative size" }
  # Reparent: move from A to B
  ba = Box.new(Axis::Row)
  bb = Box.new(Axis::Row)
  mv = Dummy.new
  ba.add(mv)
  bb.add(mv)
  expect ba.children.size == 0 && bb.children.size == 1 && mv.parent == bb, "reparent"
  puts "layout ok"
  0
end

exit main
