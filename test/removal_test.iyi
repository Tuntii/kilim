# When a widget is removed inside a handler, Ui keeps no reference.

module test/removal_test

import kilim/geom::{Rect, Size}
import kilim/event::*
import kilim/widget::*
import kilim/box::*
import kilim/ui::{Ui}
import kilim/button::{Button}
import kilim/checkbox::{Checkbox}
import kilim/testing::*

def main : Int32
  list = Box.new(Axis::Column)
  row = Box.new(Axis::Row)
  list.add(row)
  row.add(Checkbox.new("x"))
  del = Button.new("Delete", -> { list.remove(row); nil })
  row.add(del)
  rc = RecordCanvas.new
  ui = Ui.new(list, rc, MemoryClipboard.new)
  ui.resize(300_f32, 200_f32)
  ui.frame

  x = del.bounds.x + del.bounds.w / 2
  y = del.bounds.y + del.bounds.h / 2
  ui.dispatch MouseMove.new(x, y)
  ui.focus(del)
  ui.dispatch MouseDown.new(x, y, MouseButton::Left)
  ui.dispatch MouseUp.new(x, y, MouseButton::Left)
  expect list.children.empty?, "row removed"
  expect ui.focused.nil? && ui.captured.nil? && ui.hovered.nil?, "no reference left to the removed widget"
  ui.frame

  # The hovered widget goes away while another one moves under the pointer.
  a = Button.new("a")
  b = Button.new("b")
  col = Box.new(Axis::Column, [a, b] of Widget)
  ui = Ui.new(col, rc, MemoryClipboard.new)
  ui.resize(300_f32, 200_f32)
  ui.frame
  ui.dispatch MouseMove.new(a.bounds.x + 2, a.bounds.y + 2)
  expect ui.hovered == a, "a hovered"
  col.remove(a)
  ui.frame
  expect ui.hovered == b, "b is hovered once it moves under the pointer"
  expect b.hovered, "b knows it is hovered"

  puts "removal ok"
  0
end

exit main
