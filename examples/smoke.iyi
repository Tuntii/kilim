# SDL backend'inin uçtan uca denemesi: bir Label ve Button'lı pencere açılır,
# Tab + Space inject edilir, canlı resize yolu (event watch) denenir,
# smoke.bmp kaydedilir ve run döngüsü QUIT ile biter. Başarıda `smoke ok`
# yazar, 0 ile çıkar; aksi hâlde nedenini yazar, 1 ile çıkar.

module examples/smoke

import std/float
import kilim/sdl::*
import kilim/event::*
import kilim/widget::{Widget}
import kilim/box::*
import kilim/label::{Label}
import kilim/button::{Button}
import kilim/window::{Window}

PAD = 12_f32

class Counter
  property n = 0
end

def fail(why : String) : NoReturn
  puts "smoke FAIL: #{why}"
  exit 1
end

def push(e : LibSDL3::Event) : Nil
  fail("SDL_PushEvent") unless LibSDL3.SDL_PushEvent(pointerof(e))
end

def push_button(type : UInt32, x : Float32, y : Float32) : Nil
  e = LibSDL3::Event.new
  b = LibSDL3::MouseButtonEvent.new
  b.type = type
  b.button = LibSDL3::BUTTON_LEFT
  b.down = type == LibSDL3::EVENT_MOUSE_BUTTON_DOWN
  b.x = x
  b.y = y
  pointerof(e).as(LibSDL3::MouseButtonEvent*).value = b
  push(e)
end

def push_key(key : UInt32) : Nil
  e = LibSDL3::Event.new
  k = LibSDL3::KeyboardEvent.new
  k.type = LibSDL3::EVENT_KEY_DOWN
  k.key = key
  k.down = true
  pointerof(e).as(LibSDL3::KeyboardEvent*).value = k
  push(e)
end

def main : Int32
  n = Counter.new
  button = Button.new("Tamam", -> { n.n += 1; nil })
  root = Box.new(Axis::Column, [Label.new("Merhaba şöğüt"), button] of Widget, padding: PAD, spacing: 8_f32)
  win = Window.new("smoke", 320, 200, root)
  win.step

  win.inject KeyDown.new(Key::Tab, Mods.new)
  fail("Tab butona odaklanmadı") unless button.focused
  win.inject KeyDown.new(Key::Space, Mods.new)
  fail("Space sonrası sayaç #{n.n}, beklenen 1") unless n.n == 1
  win.step

  # SDL olay çevirisi: kuyruğa konan gerçek SDL olayları da butona ulaşmalı.
  cx = button.bounds.x + button.bounds.w / 2
  cy = button.bounds.y + button.bounds.h / 2
  push_button(LibSDL3::EVENT_MOUSE_BUTTON_DOWN, cx, cy)
  push_button(LibSDL3::EVENT_MOUSE_BUTTON_UP, cx, cy)
  push_key(LibSDL3::KEY_RETURN)
  win.step
  fail("SDL tıklama + Enter sonrası sayaç #{n.n}, beklenen 3") unless n.n == 3

  # Canlı resize yolu: SetWindowSize'ın ürettiği WINDOW_RESIZED, döngü hiç
  # çalışmadan watch'ta layout + çizim yaptırmalı. Pencere yöneticisi hangi
  # boyutu verdiyse buton genişliği ona uymalı.
  LibSDL3.SDL_SetWindowSize(win.handle, 400, 240)
  LibSDL3.SDL_SyncWindow(win.handle)
  w = h = 0
  LibSDL3.SDL_GetWindowSize(win.handle, pointerof(w), pointerof(h))
  expected = w - 2 * PAD
  fail("resize sonrası buton genişliği #{button.bounds.w}, beklenen #{expected} (pencere #{w}x#{h})") unless button.bounds.w == expected
  puts "resize: #{w}x#{h}, density #{LibSDL3.SDL_GetWindowPixelDensity(win.handle)}"

  win.step
  win.screenshot("smoke.bmp")

  # run'ın bekleyen döngüsü QUIT ile bitmeli (ve pencereyi kapatmalı).
  quit = LibSDL3::Event.new
  quit.type = LibSDL3::EVENT_QUIT
  LibSDL3.SDL_PushEvent(pointerof(quit))
  win.run
  puts "smoke ok"
  0
end

exit main
