# End-to-end check of the SDL backend: opens a window with a Label and a Button,
# injects Tab + Space, exercises the live resize path (event watch),
# saves smoke.bmp, hands values sent from other threads to the UI thread (Inbox) and
# ends the run loop with a QUIT sent that way. On success it prints
# `smoke ok` and exits 0; otherwise it prints the reason and exits 1.
# On Windows build it with -Dsdl (the native backend has examples/smoke_win32.iyi).

module examples/smoke

import std/float
import kilim/sdl::*
import kilim/event::*
import kilim/widget::{Widget}
import kilim/box::*
import kilim/label::{Label}
import kilim/button::{Button}
import kilim/window::{Window}

PAD = 12_f32

class Counter
  property n = 0
end

def fail(why : String) : NoReturn
  puts "smoke FAIL: #{why}"
  exit 1
end

def push(e : LibSDL3::Event) : Nil
  fail("SDL_PushEvent") unless LibSDL3.SDL_PushEvent(pointerof(e))
end

def push_button(type : UInt32, x : Float32, y : Float32) : Nil
  e = LibSDL3::Event.new
  b = LibSDL3::MouseButtonEvent.new
  b.type = type
  b.button = LibSDL3::BUTTON_LEFT
  b.down = type == LibSDL3::EVENT_MOUSE_BUTTON_DOWN
  b.x = x
  b.y = y
  pointerof(e).as(LibSDL3::MouseButtonEvent*).value = b
  push(e)
end

def push_key(key : UInt32) : Nil
  e = LibSDL3::Event.new
  k = LibSDL3::KeyboardEvent.new
  k.type = LibSDL3::EVENT_KEY_DOWN
  k.key = key
  k.down = true
  pointerof(e).as(LibSDL3::KeyboardEvent*).value = k
  push(e)
end

def push_quit : Nil
  e = LibSDL3::Event.new
  e.type = LibSDL3::EVENT_QUIT
  push(e)
end

def main : Int32
  n = Counter.new
  button = Button.new("OK", -> { n.n += 1; nil })
  title = Label.new("Merhaba şöğüt")
  root = Box.new(Axis::Column, [title, button] of Widget, padding: PAD, spacing: 8_f32)
  win = Window.new("smoke", 320, 200, root)
  win.step

  win.inject KeyDown.new(Key::Tab, Mods.new)
  fail("Tab did not focus the button") unless button.focused
  win.inject KeyDown.new(Key::Space, Mods.new)
  fail("counter after Space is #{n.n}, expected 1") unless n.n == 1
  win.step

  # SDL event translation: real SDL events pushed onto the queue must reach the button too.
  cx = button.bounds.x + button.bounds.w / 2
  cy = button.bounds.y + button.bounds.h / 2
  push_button(LibSDL3::EVENT_MOUSE_BUTTON_DOWN, cx, cy)
  push_button(LibSDL3::EVENT_MOUSE_BUTTON_UP, cx, cy)
  push_key(LibSDL3::KEY_RETURN)
  win.step
  fail("counter after SDL click + Enter is #{n.n}, expected 3") unless n.n == 3

  # Live resize path: the WINDOW_RESIZED produced by SetWindowSize must trigger
  # layout + drawing in the watch even though the loop has not run at all. Whatever
  # size the window manager granted, the button width must match it.
  LibSDL3.SDL_SetWindowSize(win.handle, 400, 240)
  LibSDL3.SDL_SyncWindow(win.handle)
  w = h = 0
  LibSDL3.SDL_GetWindowSize(win.handle, pointerof(w), pointerof(h))
  expected = w - 2 * PAD
  fail("button width after resize is #{button.bounds.w}, expected #{expected} (window #{w}x#{h})") unless button.bounds.w == expected
  puts "resize: #{w}x#{h}, density #{LibSDL3.SDL_GetWindowPixelDensity(win.handle)}"

  win.step
  win.screenshot("smoke.bmp")

  # Timers: a repeating timer ticks while the loop steps, and stops once cancelled.
  ticks = 0
  id = win.every(10) { ticks += 1; nil }
  t0 = LibSDL3.SDL_GetTicks
  while ticks < 2 && LibSDL3.SDL_GetTicks - t0 < 200_u64
    win.step
  end
  fail("timer ran #{ticks} times in 200 ms, expected at least 2") if ticks < 2
  win.cancel_timer(id)
  seen = ticks
  t0 = LibSDL3.SDL_GetTicks
  while LibSDL3.SDL_GetTicks - t0 < 50_u64
    win.step
  end
  fail("timer ran #{ticks - seen} more times after cancel_timer") unless ticks == seen
  puts "timers: ok (#{seen} ticks)"

  # Inbox: a value sent from another thread reaches its handler on the UI thread.
  results = win.inbox(String) { |s| title.text = s; nil }
  group do |g|
    g.spawn_parallel { sleep(20); results.send("done"); nil }
    t0 = LibSDL3.SDL_GetTicks
    while title.text != "done" && LibSDL3.SDL_GetTicks - t0 < 2000_u64
      win.step
    end
  end
  fail("label after the inbox send is #{title.text.inspect}, expected \"done\"") unless title.text == "done"
  puts "inbox: ok"

  # run's pending loop must end on QUIT (and close the window). The first timer shows a
  # timer wakes the wait; after it only a send from another thread can, and that
  # handler pushes QUIT. It must run soon after the send (60 ms): any later wake
  # (a timer's timeout ending early, a stray event) would deliver it too. The 1 s
  # timer only keeps a broken wake from hanging the test.
  ticked = false
  took = -1_i64
  win.after(30) { ticked = true; nil }
  win.after(1000) { push_quit; nil }
  t0 = LibSDL3.SDL_GetTicks
  closer = win.inbox(String) { |_s| took = (LibSDL3.SDL_GetTicks - t0).to_i64; push_quit; nil }
  group do |g|
    g.spawn_parallel { sleep(60); closer.send("close"); nil }
    win.run
  end
  fail("the timer did not wake the loop") unless ticked
  fail("a send from another thread did not wake the loop (handler ran at #{took} ms)") unless took >= 0 && took < 200
  puts "inbox wake: #{took} ms"

  # Closed: a send is accepted and dropped, so no handler can touch the closed window.
  closer.send("late")
  results.send("late")
  fail("a send after close was queued") unless closer.take.size == 0 && results.take.size == 0
  fail("a handler ran after close") unless title.text == "done"
  puts "smoke ok"
  0
end

exit main
