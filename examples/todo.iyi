# Acceptance example: a to-do list. If `KILIM_SELFTEST=<bmp path>` is set,
# the window is not used by hand; events are injected, the result is verified,
# a screenshot is written and the program exits 0 (if verification fails:
# message + exit 1).

module examples/todo

import std/float
import kilim
import kilim/widget::{Widget}
import kilim/window::{Window}
import kilim/box::{Box}
import kilim/button::{Button}
import kilim/checkbox::{Checkbox}
import kilim/textbox::{Textbox}
import kilim/scroll::{Scroll}
import kilim/event::*
import kilim/canvas::{Color}
import kilim/theme::{PADDING, SELECTION}

# The Delete button's closure only learns its own row after the row is built.
class Slot
  property row : Widget? = nil
end

class App
  getter input : Textbox
  getter list : Box
  getter scroll : Scroll
  getter root : Box
  # For the self-test: a checkbox and a Delete button per row (deleted ones stay).
  getter checks = [] of Checkbox
  getter dels = [] of Button
  # Set once the window exists; Delete asks through it.
  property ui : Kilim::Widget::Context? = nil

  def initialize
    @list = Kilim.column(spacing: 4)
    @scroll = Kilim.scroll(@list)
    @input = Kilim.textbox("New task...", on_submit: ->(s : String) { add_text(s) })
    add_btn = Kilim.button("Add", -> { add_text(@input.text) })
    top = Kilim.row([@input, add_btn] of Widget, spacing: 8)
    @root = Kilim.column([top, @scroll] of Widget, padding: 12, spacing: 8)
  end

  def add_text(raw : String) : Nil
    text = raw.strip
    return if text.empty?
    slot = Slot.new
    check = Kilim.checkbox(text, sizing: Kilim.fill)
    del = Kilim.button("Delete", -> { confirm_remove(slot) })
    row = Kilim.row([check, del] of Widget, spacing: 8)
    slot.row = row
    @checks << check
    @dels << del
    @list.add(row)
    @input.text = ""
  end

  def confirm_remove(slot : Slot) : Nil
    if u = @ui
      Kilim.confirm(u, "Delete task", "Delete this task?", "Delete") { remove(slot) }
    else
      remove(slot)
    end
  end

  def remove(slot : Slot) : Nil
    if r = slot.row
      @list.remove(r)
    end
  end
end

# Same colour, within 2 per channel (colour conversion may round).
def near?(p : UInt32, c : Color) : Bool
  ch = ->(shift : Int32, v : UInt8) { (((p >> shift) & 0xFF_u32).to_i - v.to_i).abs <= 2 }
  ch.call(16, c.r) && ch.call(8, c.g) && ch.call(0, c.b)
end

def fail(why : String) : NoReturn
  puts "todo FAIL: #{why}"
  exit 1
end

def click(win : Window, w : Widget) : Nil
  win.step
  x = w.bounds.x + w.bounds.w / 2
  y = w.bounds.y + w.bounds.h / 2
  win.inject MouseDown.new(x, y, MouseButton::Left)
  win.inject MouseUp.new(x, y, MouseButton::Left)
end

def wheel(win : Window, w : Widget, dy : Float32) : Nil
  win.step
  win.inject Wheel.new(w.bounds.x + w.bounds.w / 2, w.bounds.y + w.bounds.h / 2, dy)
end

def modal?(app : App) : Bool
  if u = app.ui
    return !u.modal.nil?
  end
  false
end

def selftest(win : Window, app : App, bmp : String) : Nil
  win.step
  win.inject KeyDown.new(Key::Tab, Mods.new)
  fail("Tab did not focus the textbox") unless app.input.focused
  win.inject TextInput.new("Çalışma şöğüt ılık İzmir")
  win.inject KeyDown.new(Key::Enter, Mods.new)
  fail("#{app.list.children.size} rows after Enter, expected 1") unless app.list.children.size == 1
  fail("textbox not empty after Enter: #{app.input.text}") unless app.input.text == ""
  fail("row text is #{app.checks[0].text}") unless app.checks[0].text == "Çalışma şöğüt ılık İzmir"

  win.inject KeyDown.new(Key::Enter, Mods.new)
  fail("empty Enter added a row (#{app.list.children.size})") unless app.list.children.size == 1

  click(win, app.checks[0])
  fail("first row was not checked") unless app.checks[0].checked

  30.times { |i| app.add_text("İş #{i + 1} ığdır çğış") }
  fail("#{app.list.children.size} rows after 30 adds, expected 31") unless app.list.children.size == 31
  wheel(win, app.scroll, -3_f32)
  fail("wheel did not scroll (offset #{app.scroll.offset})") unless app.scroll.offset > 0

  # Rows scrolled out of view are deliberately not clickable; scroll back to the top.
  wheel(win, app.scroll, 100_f32)
  fail("could not scroll back to top (offset #{app.scroll.offset})") unless app.scroll.offset == 0

  # Delete asks first: Escape keeps the row, Enter (OK has the focus) deletes it.
  click(win, app.dels[0])
  fail("Delete did not open the confirm dialog") unless modal?(app)
  win.inject KeyDown.new(Key::Escape, Mods.new)
  fail("Escape did not close the dialog") if modal?(app)
  fail("#{app.list.children.size} rows after cancelled Delete, expected 31") unless app.list.children.size == 31
  click(win, app.dels[0])
  win.step
  win.inject KeyDown.new(Key::Enter, Mods.new)
  fail("#{app.list.children.size} rows after confirmed Delete, expected 30") unless app.list.children.size == 30

  # Drag-select the start of the typed text.
  click(win, app.input)
  win.inject TextInput.new("Çalışma şöğüt")
  win.step
  ib = app.input.bounds
  y = ib.y + ib.h / 2
  win.inject MouseDown.new(ib.x + PADDING + 1, y, MouseButton::Left)
  win.inject MouseMove.new(ib.x + PADDING + 60, y)
  win.inject MouseUp.new(ib.x + PADDING + 60, y, MouseButton::Left)

  win.step
  px = win.screenshot(bmp)
  # Only the native backend returns pixels: the selection colour must show inside the box.
  {% if flag?(:win32) && !flag?(:sdl) %}
    d = win.density
    w = (480 * d).round.to_i # the window is 480 logical units wide
    hits = 0
    yy = ib.y + 4
    while yy < ib.y + ib.h - 4
      xx = ib.x + PADDING
      while xx < ib.x + PADDING + 60
        p = px[(yy * d).to_i * w + (xx * d).to_i]
        hits += 1 if near?(p, SELECTION)
        xx += 1
      end
      yy += 1
    end
    fail("selection colour not found in the textbox (#{hits} pixels)") if hits < 100
  {% end %}
  win.close
  puts "todo selftest ok"
end

def main : Int32
  app = App.new
  win = Kilim.window("kilim todo", 480, 420, app.root)
  app.ui = win.ui
  if bmp = ENV["KILIM_SELFTEST"]?
    selftest(win, app, bmp)
  else
    win.run
  end
  0
end

exit main
