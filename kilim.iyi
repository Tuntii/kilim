# kilim's user API: window, widget constructors and sizing shortcuts.
# The types (Widget, Label, Button, ...) live in their own modules
# (kilim/widget, kilim/label, ...); this module only holds constructor functions.
# Submodules are re-exported with `pub import`: with just
# `import github.com/tuntii/kilim` you can write qualified names like `Kilim::Widget::Widget`.
# shortcut: no `pub alias` for the types (iyi rejects it because the name is a module);
# for a short name, import the submodule separately with `::{Type}`.

module kilim

pub import kilim/widget
pub import kilim/box
pub import kilim/label
pub import kilim/button
pub import kilim/checkbox
pub import kilim/textbox
pub import kilim/text_area
pub import kilim/scroll
pub import kilim/list_view
pub import kilim/dropdown
pub import kilim/dialog
pub import kilim/event
pub import kilim/window

pub def window(title : String, width : Int32, height : Int32, child : Kilim::Widget::Widget) : Kilim::Window::Window
  Kilim::Window::Window.new(title, width, height, child)
end

pub def column(children : Array(Kilim::Widget::Widget) = [] of Kilim::Widget::Widget, padding : Float32 = 0_f32, spacing : Float32 = 0_f32, sizing : Kilim::Widget::Sizing = Kilim::Widget::Sizing.fit) : Kilim::Box::Box
  Kilim::Box::Box.new(Kilim::Box::Axis::Column, children, padding, spacing, sizing)
end

pub def row(children : Array(Kilim::Widget::Widget) = [] of Kilim::Widget::Widget, padding : Float32 = 0_f32, spacing : Float32 = 0_f32, sizing : Kilim::Widget::Sizing = Kilim::Widget::Sizing.fit) : Kilim::Box::Box
  Kilim::Box::Box.new(Kilim::Box::Axis::Row, children, padding, spacing, sizing)
end

pub def label(text : String) : Kilim::Label::Label
  Kilim::Label::Label.new(text)
end

pub def button(text : String, on_click : (-> Nil)? = nil, sizing : Kilim::Widget::Sizing = Kilim::Widget::Sizing.fit) : Kilim::Button::Button
  b = Kilim::Button::Button.new(text, on_click)
  b.sizing = sizing
  b
end

pub def checkbox(text : String, checked : Bool = false, on_change : (Bool -> Nil)? = nil, sizing : Kilim::Widget::Sizing = Kilim::Widget::Sizing.fit) : Kilim::Checkbox::Checkbox
  c = Kilim::Checkbox::Checkbox.new(text, checked, on_change)
  c.sizing = sizing
  c
end

pub def textbox(placeholder : String = "", on_change : (String -> Nil)? = nil, on_submit : (String -> Nil)? = nil, sizing : Kilim::Widget::Sizing = Kilim::Widget::Sizing.fill) : Kilim::Textbox::Textbox
  t = Kilim::Textbox::Textbox.new(placeholder, "", on_change, on_submit)
  t.sizing = sizing
  t
end

pub def text_area(placeholder : String = "", on_change : (String -> Nil)? = nil, sizing : Kilim::Widget::Sizing = Kilim::Widget::Sizing.fill) : Kilim::TextArea::TextArea
  t = Kilim::TextArea::TextArea.new(placeholder, "", on_change)
  t.sizing = sizing
  t
end

pub def scroll(child : Kilim::Widget::Widget, sizing : Kilim::Widget::Sizing = Kilim::Widget::Sizing.fill) : Kilim::Scroll::Scroll
  s = Kilim::Scroll::Scroll.new(child)
  s.sizing = sizing
  s
end

pub def list_view(on_select : (Int32 -> Nil)? = nil, sizing : Kilim::Widget::Sizing = Kilim::Widget::Sizing.fill) : Kilim::ListView::ListView
  l = Kilim::ListView::ListView.new(on_select)
  l.sizing = sizing
  l
end

pub def dropdown(options : Array(String), selected : Int32 = 0, on_change : (Int32 -> Nil)? = nil, sizing : Kilim::Widget::Sizing = Kilim::Widget::Sizing.fit) : Kilim::Dropdown::Dropdown
  d = Kilim::Dropdown::Dropdown.new(options, selected, on_change)
  d.sizing = sizing
  d
end

# Asks before doing something: Cancel / ok_text over a dimmed window. Enter or the OK button runs the block,
# Escape or Cancel just closes. OK has the focus when it opens, so Enter alone confirms.
pub def confirm(ui : Kilim::Widget::Context, title : String, message : String, ok_text : String = "OK", &on_ok : -> Nil) : Nil
  Kilim::Dialog.confirm(ui, title, message, ok_text, &on_ok)
end

pub def fit : Kilim::Widget::Sizing
  Kilim::Widget::Sizing.fit
end

pub def fixed(v : Float32) : Kilim::Widget::Sizing
  Kilim::Widget::Sizing.fixed(v)
end

pub def fill(weight : Float32 = 1_f32) : Kilim::Widget::Sizing
  Kilim::Widget::Sizing.fill(weight)
end
